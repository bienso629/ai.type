# MẪU CẤU HÌNH DÀNH CHO APPLE CODE SIGN + NOTARIZATION

# Tài khoản Apple Developer (email của bạn)
APPLE_ID=your_apple_id@example.com

# Mật khẩu App-Specific (tạo từ appleid.apple.com)
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Nếu dùng file certificate .p12 để ký (tuỳ chọn)
# CSC_LINK=/absolute/path/to/your-certificate.p12
# CSC_KEY_PASSWORD=your-p12-password
