{
    "productName": "AI.Type Lite",
    "appId": "ai.type.vn",
    "asar": true,
    "files": [
        "dist/main.js",
        "preload.js",
        "fallback/**/*",
        "icons/**/*",
        "node_modules/**/*",
        "package.json",
        "!downloader-*",
        "!type-lite-*"
    ],
    "win": {
        "icon": "icons/icon.ico",
