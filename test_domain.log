https://ai.type.vn/wp-json/wp/v2/posts?tags=225"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":224,"link":"https://ai.type.vn/t/tu-dong-tao-bai-viet-chuan-seo","name":"Tự động tạo bài viết chuẩn SEO","slug":"tu-dong-tao-bai-viet-chuan-seo","taxonomy":"post_tag","_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags/224","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/taxonomies/post_tag"}],"wp:post_type":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts?tags=224"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]]}},{"id":3075,"date":"2025-10-05T05:55:25","date_gmt":"2025-10-05T05:55:25","guid":{"rendered":"https://ai.type.vn/?p=3075"},"modified":"2025-10-11T05:32:22","modified_gmt":"2025-10-11T05:32:22","slug":"tich-hop-gemini-vao-ai-type-nhu-the-nao","status":"publish","type":"post","link":"https://ai.type.vn/tich-hop-gemini-vao-ai-type-nhu-the-nao.html","title":{"rendered":"Tích hợp Gemini vào AI Type như thế nào?"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Chào mừng các bạn đến với thế giới của trí tuệ nhân tạo! Hôm nay, chúng ta sẽ cùng nhau khám phá cách tạo <strong>Google AI API key</strong> để tích hợp vào AI.Type một cách dễ dàng và nhanh chóng. Đừng lo lắng nếu bạn là người mới bắt đầu, vì hướng dẫn này được viết dành riêng cho bạn, giống như một người bạn đang trò chuyện và hướng dẫn bạn từng bước.</p>\n\n\n\n<p class=\"has-pale-ocean-gradient-background has-background wp-block-paragraph\" style=\"font-size:18px\">Và <a href=\"#\"><strong>sau khi tích hợp Google AI API Key vô AI.Type rồi thì làm gì tiếp?</strong></a> thì mời các bạn đọc bài sau.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Bước 1: Truy Cập Google AI Studio</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Đầu tiên, hãy mở trình duyệt web yêu thích của bạn và truy cập vào <a href=\"https://aistudio.google.com/app/api-keys\" rel=\"nofollow noopener\" target=\"_blank\"><strong>Google AI Studio</strong></a>. Đây là nơi chúng ta sẽ &#8220;nhào nặn&#8221; ra chiếc chìa khóa API thần kỳ.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Bước 2: Đăng Nhập Tài Khoản Google</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Bạn sẽ cần đăng nhập bằng tài khoản Google của mình. Hãy chắc chắn rằng bạn sử dụng tài khoản mà bạn muốn liên kết với dự án AI của mình. Nếu bạn chưa có tài khoản, hãy tạo một tài khoản mới, việc này chỉ mất vài phút thôi!</p>\n\n\n\n<h2 class=\"wp-block-heading\">Bước 3: Chấp Nhận Điều Khoản Dịch Vụ</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Google sẽ yêu cầu bạn chấp nhận các điều khoản dịch vụ. Hãy đọc kỹ (nếu bạn có thời gian!) và đánh dấu vào ô chấp nhận. Đây là bước quan trọng để đảm bảo bạn tuân thủ các quy định của Google.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Bước 4: Tạo API Key Mới</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Đây là phần quan trọng nhất! Bạn sẽ thấy nút &#8220;<strong>Create API key</strong>&#8221; (hoặc &#8220;Get API key&#8221; nếu bạn đã có project). Hãy nhấn vào đó. Nếu bạn mới bắt đầu, hãy chọn tạo một project mới. Google sẽ tự động tạo một project cho bạn và cấp cho bạn một API key.</p>\n\n\n\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"2560\" height=\"1292\" src=\"https://ai.type.vn/wp-content/uploads/2025/10/Google-AI-Studio-1-scaled.png\" alt=\"Điền đầy đủ thông tin và chọn 1 project cho API key của bạn.\" class=\"wp-image-3092\" style=\"box-shadow:var(--wp--preset--shadow--natural)\" title=\"\" srcset=\"https://ai.type.vn/wp-content/uploads/2025/10/Google-AI-Studio-1-scaled.png 2560w, https://ai.type.vn/wp-content/uploads/2025/10/Google-AI-Studio-1-scaled-793x400.png 793w, https://ai.type.vn/wp-content/uploads/2025/10/Google-AI-Studio-1-scaled-1400x707.png 1400w, https://ai.type.vn/wp-content/uploads/2025/10/Google-AI-Studio-1-scaled-768x388.png 768w, https://ai.type.vn/wp-content/uploads/2025/10/Google-AI-Studio-1-scaled-1536x775.png 1536w, https://ai.type.vn/wp-content/uploads/2025/10/Google-AI-Studio-1-scaled-2048x1034.png 2048w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" /><figcaption class=\"wp-element-caption\">Điền đầy đủ thông tin và chọn 1 project cho API key của bạn.</figcaption></figure>\n\n\n\n<h2 class=\"wp-block-heading\">Bước 5: Sao Chép API Key</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Sau khi tạo, API key của bạn sẽ được hiển thị. Hãy sao chép nó một cách cẩn thận. API key này giống như một chiếc chìa khóa bí mật, vì vậy đừng chia sẻ nó với bất kỳ ai! Hãy lưu trữ nó ở một nơi an toàn.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Bước cuối: Sử Dụng API Key Trong AI.Type</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Cuối cùng, hãy mở ứng dụng AI.Type của bạn và tìm đến phần <strong>Cài đặt</strong> (Settings). Tìm tới Cấu hình của AI và dán API key mà bạn vừa sao chép vào <strong>Gemini AI Studio</strong>, bấm nút <strong>Lưu cấu hình</strong> (màu xanh). Vậy là xong! Bây giờ, AI.Type của bạn đã sẵn sàng để sử dụng sức mạnh của Google AI.</p>\n\n\n\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"2560\" height=\"1600\" src=\"https://ai.type.vn/wp-content/uploads/2025/10/Screenshot-2025-10-05-at-14.51.50-scaled.png\" alt=\"dán API key mà bạn vừa sao chép vào Gemini AI Studio\" class=\"wp-image-3100\" style=\"box-shadow:var(--wp--preset--shadow--natural)\" title=\"\" srcset=\"https://ai.type.vn/wp-content/uploads/2025/10/Screenshot-2025-10-05-at-14.51.50-scaled.png 2560w, https://ai.type.vn/wp-content/uploads/2025/10/Screenshot-2025-10-05-at-14.51.50-scaled-640x400.png 640w, https://ai.type.vn/wp-content/uploads/2025/10/Screenshot-2025-10-05-at-14.51.50-scaled-1280x800.png 1280w, https://ai.type.vn/wp-content/uploads/2025/10/Screenshot-2025-10-05-at-14.51.50-scaled-768x480.png 768w, https://ai.type.vn/wp-content/uploads/2025/10/Screenshot-2025-10-05-at-14.51.50-scaled-1536x960.png 1536w, https://ai.type.vn/wp-content/uploads/2025/10/Screenshot-2025-10-05-at-14.51.50-scaled-2048x1280.png 2048w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" /><figcaption class=\"wp-element-caption\">Dán API key mà bạn vừa sao chép vào <strong>Gemini AI Studio</strong></figcaption></figure>\n\n\n\n<p class=\"wp-block-paragraph\">Chúc mừng bạn đã hoàn thành! Hy vọng hướng dẫn này hữu ích và dễ hiểu. Nếu bạn gặp bất kỳ khó khăn nào, đừng ngần ngại liên hệ với chúng tôi hoặc truy cập <a href=\"https://ai.type.vn\" title=\"AI.Type\">AI.Type</a> để được hỗ trợ thêm.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Xin chào! Mình là Yên AI, rất vui được làm quen với bạn.</p>\n","protected":false},"excerpt":{"rendered":"<p>Hướng dẫn chi tiết cách tạo Google AI API key để sử dụng trong AI.Type. Bài viết này sẽ giúp bạn từng bước, từ truy cập Google AI Studio đến dán API key vào AI.Type, một cách dễ dàng, kể cả khi bạn là người mới bắt đầu.</p>\n","protected":false},"author":1,"featured_media":3085,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[146],"tags":[220,222,221],"class_list":["post-3075","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-simple-chatbot-tich-hop","tag-dieu-khoan-dich-vu-google","tag-google-ai-api-key","tag-tao-api-key-moi"],"_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts/3075","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/types/post"}],"author":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/users/1"}],"replies":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/comments?post=3075"}],"version-history":[{"count":0,"href":"https://ai.type.vn/wp-json/wp/v2/posts/3075/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/media/3085"}],"wp:attachm