tion":[{"href":"https://ai.type.vn/wp-json/wp/v2/media"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/types/attachment"}],"author":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/users/1"}],"replies":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/comments?post=3404"}],"wp:attached-to":[{"embeddable":true,"post_type":"post","id":3385,"href":"https://ai.type.vn/wp-json/wp/v2/posts/3385"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}],"wp:term":[[{"id":157,"link":"https://ai.type.vn/c/tai-khoan-su-dung","name":"Tài khoản sử dụng","slug":"tai-khoan-su-dung","taxonomy":"category","_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/categories/157","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/categories"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/taxonomies/category"}],"wp:post_type":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts?categories=157"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}],[{"id":254,"link":"https://ai.type.vn/t/kich-hoat-phan-mem-ai-type","name":"Kích hoạt phần mềm AI Type","slug":"kich-hoat-phan-mem-ai-type","taxonomy":"post_tag","_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags/254","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/taxonomies/post_tag"}],"wp:post_type":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts?tags=254"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]]}},{"id":3327,"date":"2026-02-16T09:06:46","date_gmt":"2026-02-16T09:06:46","guid":{"rendered":"https://ai.type.vn/?p=3327"},"modified":"2026-02-25T13:18:40","modified_gmt":"2026-02-25T13:18:40","slug":"cach-ket-noi-tai-khoan-ai-type-voi-simple-chatbot","status":"publish","type":"post","link":"https://ai.type.vn/cach-ket-noi-tai-khoan-ai-type-voi-simple-chatbot.html","title":{"rendered":"Cách kết nối tài khoản AI Type với Simple Chatbot"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Sau khi bạn đã có tài khoản trên AI Type, bước tiếp theo là tiến hành đăng nhập và sử dụng tính năng Simple Chatbot như một công cụ hỗ trợ làm việc cho bạn. Cách kích hoạt và cấu hình Simple Chatbot sẽ được mô tả chi tiết trong bài viết này.</p>\n\n\n\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"2560\" height=\"1600\" src=\"https://ai.type.vn/wp-content/uploads/2026/02/screenshot_1770867057165-scaled.png\" alt=\"Màn hình Chatbot trong phần mềm AI Type\" class=\"wp-image-3290\" title=\"\" srcset=\"https://ai.type.vn/wp-content/uploads/2026/02/screenshot_1770867057165-scaled.png 2560w, https://ai.type.vn/wp-content/uploads/2026/02/screenshot_1770867057165-640x400.png 640w, https://ai.type.vn/wp-content/uploads/2026/02/screenshot_1770867057165-1280x800.png 1280w, https://ai.type.vn/wp-content/uploads/2026/02/screenshot_1770867057165-768x480.png 768w, https://ai.type.vn/wp-content/uploads/2026/02/screenshot_1770867057165-1536x960.png 1536w, https://ai.type.vn/wp-content/uploads/2026/02/screenshot_1770867057165-2048x1280.png 2048w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" /><figcaption class=\"wp-element-caption\">Màn hình Chatbot trong phần mềm AI Type</figcaption></figure>\n\n\n\n<h2 class=\"wp-block-heading\">Hướng dẫn sử dụng Simple Chatbot trong AI Type</h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Bấm nút Chatbot để bắt đầu</strong>: Sau khi bạn <strong>bắt đầu công việc</strong> của mình, hãy bấm nút Chatbot ở màn hình giao diện Chức năng.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Bấm nút Tải PDF hoặc DOCx để tải tài liệu</strong>: Trong giao diện Chatbot, hãy bấm nút Tải PDF, DOCx màu xanh. Sau đó, chọn file PDF bạn muốn tải lên.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Sau khi đã tải xong Tài liệu bấm Quản lý Tài liệu</strong>: Đợi quá trình tải PDF xong, hãy bấm vào link Quản lý Tài liệu. Một danh sách các tài liệu đã tải lên của bạn hiện ra, tại danh sách này bạn có thể cập nhật kiến thức cho Chatbot.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Xoá hoặc Cập nhật dữ liệu cho Chatbot</strong>: Xoá file PDF nếu thấy không cần thiết cho Chatbot của bạn nữa.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Lựa chọn chế độ trả lời cho Chatbot</strong>: Sau khi đã cập nhật kiến thức cho Chatbot của bạn, hãy lựa chọn cách trả lời của Chatbot nhé. </p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Trong cấu hình Chatbot của bạn có 3 chế độ: Documents, Website và Tất cả, bạn có thể chọn 1 trong 3 chế độ này. Lưu ý: chọn chế độ All sẽ mất nhiều thời gian hơn để Chatbot trả lời câu hỏi của bạn.</em></p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1280\" height=\"800\" src=\"https://ai.type.vn/wp-content/uploads/2026/02/Screenshot-2026-02-25-at-20.15.46-1280x800.png\" alt=\"Cấu hình tài khoản AI Type với Simple Chatbot\" class=\"wp-image-3420\" title=\"\" srcset=\"https://ai.type.vn/wp-content/uploads/2026/02/Screenshot-2026-02-25-at-20.15.46-1280x800.png 1280w, https://ai.type.vn/wp-content/uploads/2026/02/Screenshot-2026-02-25-at-20.15.46-640x400.png 640w, https://ai.type.vn/wp-content/uploads/2026/02/Screenshot-2026-02-25-at-20.15.46-768x480.png 768w, https://ai.type.vn/wp-content/uploads/2026/02/Screenshot-2026-02-25-at-20.15.46-1536x960.png 1536w, https://ai.type.vn/wp-content/uploads/2026/02/Screenshot-2026-02-25-at-20.15.46-2048x1280.png 2048w\" sizes=\"auto, (max-width: 1280px) 100vw, 1280px\" /><figcaption class=\"wp-element-caption\">Cấu hình tài khoản AI Type với Simple Chatbot</figcaption></figure>\n\n\n\n<p class=\"wp-block-paragraph\">Mở rộng: <strong>Để Bot có thể học được nội dung website</strong>, bạn hãy bấm vào link Bot học Website và chọn domain có trong danh sách của bạn. Hãy kiểm tra các sitemap một lần nữa và bấm nút Tiếp tục.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Chúc các bạn thành công!</p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n","protected":false},"excerpt":{"rendered":"<p>Sau khi bạn đã có tài khoản trên AI Type, bước tiếp theo là tiến hành đăng nhập và sử dụng tính năng Simple Chatbot như một công cụ hỗ trợ làm việc cho bạn. Cách kích hoạt và cấu hình Simple Chatbot sẽ được mô tả chi tiết trong bài viết này. Hướng dẫnĐọc</p>\n","protected":false},"author":1,"featured_media":3375,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[146],"tags":[250,251,253,252,249],"class_list":["post-3327","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-simple-chatbot-tich-hop","tag-cai-dat-chatbot","tag-cai-dat-simple-chatbot","tag-chatbot-phuc-vu-cong-viec","tag-ket-noi-chatbot-voi-ai-type","tag-simple-chatbot"],"_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts/3327","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/types/post"}],"author":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/users/1"}],"replies":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/comments?post=3327"}],"version-history":[{"count":16,"href":"https://ai.type.vn/wp-json/wp/v2/posts/3327/revisions"}],"predecessor-version":[{"id":3425,"href":"https://ai.type.vn/wp-json/wp/v2/posts/3327/revisions/3425"}],"wp:featuredmedia":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/media/3375"}],"wp:attachment":[{"href":"https://ai.type.vn/wp-json/wp/v2/media?parent=3327"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/categories?post=3327"},{"taxonomy":"post_tag","embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/tags?post=3327"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]},"_embedded":{"au