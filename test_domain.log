n/wp/v2/posts?tags=205"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":207,"link":"https://ai.type.vn/t/noi-dung-bai-viet","name":"nội dung bài viết","slug":"noi-dung-bai-viet","taxonomy":"post_tag","_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags/207","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/taxonomies/post_tag"}],"wp:post_type":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts?tags=207"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":204,"link":"https://ai.type.vn/t/tao-anh-bang-ai","name":"tạo ảnh bằng AI","slug":"tao-anh-bang-ai","taxonomy":"post_tag","_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags/204","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/taxonomies/post_tag"}],"wp:post_type":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts?tags=204"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":206,"link":"https://ai.type.vn/t/viet-prompt-hieu-qua","name":"viết prompt hiệu quả","slug":"viet-prompt-hieu-qua","taxonomy":"post_tag","_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags/206","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/tags"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/taxonomies/post_tag"}],"wp:post_type":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts?tags=206"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]]}},{"id":2890,"date":"2025-09-28T02:12:38","date_gmt":"2025-09-28T02:12:38","guid":{"rendered":"https://ai.type.vn/?p=2890"},"modified":"2025-10-01T03:30:46","modified_gmt":"2025-10-01T03:30:46","slug":"tao-hinh-anh-chuyen-nghiep-voi-ai-dreamina-trong-ai-type","status":"publish","type":"post","link":"https://ai.type.vn/tao-hinh-anh-chuyen-nghiep-voi-ai-dreamina-trong-ai-type.html","title":{"rendered":"Tạo hình ảnh chuyên nghiệp với AI Dreamina trong AI.Type"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Bạn muốn tạo ra những hình ảnh ấn tượng, phù hợp với nội dung bài viết của mình một cách nhanh chóng và dễ dàng? AI.Type đã tích hợp công cụ Dreamina, một trình tạo hình ảnh AI chuyên nghiệp, giúp bạn biến ý tưởng thành hiện thực chỉ với vài thao tác đơn giản. Hãy cùng khám phá cách sử dụng Dreamina ngay sau đây.</p>\n\n\n\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"2560\" height=\"1600\" src=\"https://ai.type.vn/wp-content/uploads/2025/09/Screenshot-2025-09-28-at-18.40.51-scaled.png\" alt=\"Một cặp đôi trẻ đang đứng trên đỉnh núi nhìn xuống thung lũng xanh mướt, trời nắng đẹp, phong cách ảnh du lịch mạo hiểm\" class=\"wp-image-2929\" style=\"box-shadow:var(--wp--preset--shadow--natural)\" title=\"\" srcset=\"https://ai.type.vn/wp-content/uploads/2025/09/Screenshot-2025-09-28-at-18.40.51-scaled.png 2560w, https://ai.type.vn/wp-content/uploads/2025/09/Screenshot-2025-09-28-at-18.40.51-scaled-640x400.png 640w, https://ai.type.vn/wp-content/uploads/2025/09/Screenshot-2025-09-28-at-18.40.51-scaled-1280x800.png 1280w, https://ai.type.vn/wp-content/uploads/2025/09/Screenshot-2025-09-28-at-18.40.51-scaled-768x480.png 768w, https://ai.type.vn/wp-content/uploads/2025/09/Screenshot-2025-09-28-at-18.40.51-scaled-1536x960.png 1536w, https://ai.type.vn/wp-content/uploads/2025/09/Screenshot-2025-09-28-at-18.40.51-scaled-2048x1280.png 2048w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" /><figcaption class=\"wp-element-caption\">Ví dụ đặt Prompt như này: &#8220;Một cặp đôi trẻ đang đứng trên đỉnh núi nhìn xuống thung lũng xanh mướt, trời nắng đẹp, phong cách ảnh du lịch mạo hiểm&#8221;.</figcaption></figure>\n\n\n\n<h2 class=\"wp-block-heading\">Hướng Dẫn Tạo Ảnh AI Chuyên Nghiệp với Dreamina</h2>\n\n\n\n<ol class=\"wp-block-list\">\n<li><strong>Mở Dreamina:</strong> Trong trình soạn thảo của AI.Type, bạn sẽ thấy nút &#8220;Dreamina&#8221;. Hãy bấm vào đó để khởi động chương trình tạo ảnh AI.</li>\n\n\n\n<li><strong>Đăng Nhập và Nhận Token:</strong> Truy cập <a href=\"https://dreamina.capcut.com\" rel=\"nofollow noopener\" target=\"_blank\">dreamina.capcut.com</a> và đăng nhập. Bạn sẽ nhận được 300 token miễn phí mỗi ngày để thoải mái sáng tạo.</li>\n\n\n\n<li><strong>Nhập Prompt:</strong> Đây là bước quan trọng nhất. Hãy mô tả chi tiết hình ảnh bạn muốn tạo ra bằng tiếng Việt hoặc tiếng Anh. Prompt càng rõ ràng, hình ảnh tạo ra càng sát với mong muốn của bạn. Ví dụ: &#8220;Một chú mèo con đang chơi đùa trên bãi biển hoàng hôn.&#8221;</li>\n\n\n\n<li><strong>Tạo Ảnh:</strong> Sau khi nhập prompt, nhấn nút &#8220;Tạo&#8221; hoặc tương tự. Dreamina sẽ xử lý yêu cầu của bạn và tạo ra một hoặc nhiều hình ảnh dựa trên mô tả.</li>\n\n\n\n<li><strong>Tải Ảnh Về:</strong> Khi Dreamina đã tạo xong hình ảnh, bạn hãy bấm vào hình ảnh mà bạn ưng ý nhất. Một tùy chọn tải về sẽ xuất hiện, cho phép bạn lưu hình ảnh về máy tính cá nhân của mình.</li>\n</ol>\n\n\n\n<p class=\"wp-block-paragraph\">Với Dreamina tích hợp trong AI.Type, việc tạo ra hình ảnh minh họa độc đáo và chuyên nghiệp cho bài viết của bạn trở nên dễ dàng hơn bao giờ hết. Chúc bạn có những trải nghiệm tuyệt vời và tạo ra những hình ảnh ấn tượng!</p>\n\n\n\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"1584\" height=\"1056\" src=\"https://ai.type.vn/wp-content/uploads/2025/09/dream_1759060477966_2e4c9a786e.webp\" alt=\"Kết quả hình ảnh tạo ra bằng Dreamina\" class=\"wp-image-2939\" style=\"box-shadow:var(--wp--preset--shadow--natural)\" title=\"\" srcset=\"https://ai.type.vn/wp-content/uploads/2025/09/dream_1759060477966_2e4c9a786e.webp 1584w, https://ai.type.vn/wp-content/uploads/2025/09/dream_1759060477966_2e4c9a786e-600x400.webp 600w, https://ai.type.vn/wp-content/uploads/2025/09/dream_1759060477966_2e4c9a786e-1200x800.webp 1200w, https://ai.type.vn/wp-content/uploads/2025/09/dream_1759060477966_2e4c9a786e-768x512.webp 768w, https://ai.type.vn/wp-content/uploads/2025/09/dream_1759060477966_2e4c9a786e-1536x1024.webp 1536w\" sizes=\"auto, (max-width: 1584px) 100vw, 1584px\" /><figcaption class=\"wp-element-caption\">Kết quả hình ảnh tạo ra bằng Dreamina</figcaption></figure>\n\n\n\n<p class=\"wp-block-paragraph\">Để biết thêm thông tin và các tính năng hữu ích khác của AI.Type, hãy truy cập <a href=\"https://ai.type.vn\" title=\"AI.Type\">AI.Type</a> để làm link tham khảo.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Chúc các bạn ngày mới vui vẻ!, Và mình là Yên Nguyễn AI</p>\n","protected":false},"excerpt":{"rendered":"<p>Hướng dẫn chi tiết cách tạo hình ảnh chuyên nghiệp bằng AI Dremmina trong phần mềm AI.Type. Tận dụng 300 token miễn phí mỗi ngày tại dreamina.capcut.com để tạo ảnh phù hợp với bài viết.</p>\n","protected":false},"author":1,"featured_media":2913,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[156],"tags":[208,202,203],"class_list":["post-2890","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-tao-hinh-anh-san-pham","tag-cach-su-dung-dreamina","tag-phan-mem-ho-tro-viet-content","tag-tao-hinh-anh-chuyen-nghiep"],"_links":{"self":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts/2890","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://ai.type.vn/wp-json/wp/v2/posts"}],"about":[{"href":"https://ai.type.vn/wp-json/wp/v2/types/post"}],"author":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/users/1"}],"replies":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/comments?post=2890"}],"version-history":[{"count":0,"href":"https://ai.type.vn/wp-json/wp/v2/posts/2890/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https://ai.type.vn/wp-json/wp/v2/media/2913"}]