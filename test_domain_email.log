4.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132348_559.jpg 1620w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">Xác nhận thông tin cá nhân</figcaption></figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"754\" height=\"423\" data-id=\"9157\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578-1.jpg\" alt=\"\" class=\"wp-image-9157\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578-1.jpg 754w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578-1-300x168.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578-1-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578-1-150x84.jpg 150w\" sizes=\"(max-width: 754px) 100vw, 754px\" /><figcaption class=\"wp-element-caption\">CEO Nguyễn Đức Dũng cùng anh/chị/em đội ngũ Auto Invoice</figcaption></figure>\n</figure>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-5 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"575\" data-id=\"9159\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132506_105-1024x575.jpg\" alt=\"\" class=\"wp-image-9159\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132506_105-1024x575.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132506_105-300x168.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132506_105-768x431.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132506_105-1536x862.jpg 1536w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132506_105-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132506_105-150x84.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132506_105.jpg 1612w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">CEO Nguyễn Đức Dũng cùng anh Phan Luận &#8211; Đại lý Thuế Người Trợ Lý (Atax)</figcaption></figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"575\" data-id=\"9160\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132123_270-1024x575.jpg\" alt=\"\" class=\"wp-image-9160\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132123_270-1024x575.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132123_270-300x169.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132123_270-768x431.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132123_270-1536x863.jpg 1536w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132123_270-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132123_270-150x84.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132123_270.jpg 1620w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">Công tác chuẩn bị cho một sức khỏe tốt</figcaption></figure>\n</figure>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-6 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"575\" data-id=\"9161\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_133002_203-1024x575.jpg\" alt=\"\" class=\"wp-image-9161\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_133002_203-1024x575.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_133002_203-300x169.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_133002_203-768x431.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_133002_203-1536x863.jpg 1536w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_133002_203-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_133002_203-150x84.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_133002_203.jpg 1620w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">Anh Thanh Bình Tadu cùng một nụ cười tươi</figcaption></figure>\n</figure>\n\n\n\n<p class=\"wp-block-paragraph\">Để thể hiện tinh thần nhân ái, vì cộng đồng, hiểu được ý nghĩa nhân văn sâu sắc và lợi ích của việc hiến máu nhân đạo, mỗi cán bộ, công chức, viên chức, người dân đủ điều kiện hiến máu hãy cùng tham gia hoạt động hiến máu nhân đạo. </p>\n\n\n\n<p class=\"wp-block-paragraph\">Mỗi cá nhân, tập thể hãy hăng hái hưởng ứng hiến máu tình nguyện để cứu người bệnh, với nghĩa cử cao đẹp <strong><em>“Mỗi giọt máu cho đi &#8211; một cuộc đời ở lại”</em></strong>.</p>\n\n\n\n<p class=\"has-text-align-right wp-block-paragraph\">Đội ngũ <a href=\"https://autoinvoice.vn/blog\" title=\"Auto Invoice\">Hộp thư</a> thực hiện!</p>\n","protected":false},"excerpt":{"rendered":"<p>Hưởng ứng phong trào hiến máu cứu người được Hội Đại lý Thuế đề xuất, Ban lãnh đạo TADU đã động viên, khuyến khích toàn thể anh chị em nhân viên trong Công ty tích cực tham gia hiến máu nhân đạo để đóng góp cho ngân hàng máu.</p>\n","protected":false},"author":1,"featured_media":9164,"comment_status":"closed","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"inline_featured_image":false,"footnotes":""},"categories":[1],"tags":[164,186,82,185,181,180,182,115,114,78,89,88],"class_list":["post-9146","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-tin-tuc","tag-dang-ky-email-doanh-nghiep","tag-dang-ky-email-ten-mien","tag-email-doanh-nghiep","tag-email-ten-mien","tag-hien-mau-cuu-nguoi","tag-hien-mau-nhan-dao","tag-hoi-dai-ly-thue","tag-hop-thu","tag-hop-thu-doanh-nghiep","tag-hopthu-vn","tag-tadu","tag-tadu-cloud"],"_links":{"sel