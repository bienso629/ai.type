[{"href":"https://hopthu.vn/wp-json/wp/v2/tags"}],"about":[{"href":"https://hopthu.vn/wp-json/wp/v2/taxonomies/post_tag"}],"wp:post_type":[{"href":"https://hopthu.vn/wp-json/wp/v2/posts?tags=114"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":78,"link":"https://hopthu.vn/t/hopthu-vn/","name":"hopthu.vn","slug":"hopthu-vn","taxonomy":"post_tag","_links":{"self":[{"href":"https://hopthu.vn/wp-json/wp/v2/tags/78","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://hopthu.vn/wp-json/wp/v2/tags"}],"about":[{"href":"https://hopthu.vn/wp-json/wp/v2/taxonomies/post_tag"}],"wp:post_type":[{"href":"https://hopthu.vn/wp-json/wp/v2/posts?tags=78"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}},{"id":184,"link":"https://hopthu.vn/t/thuenhanuoc-vn/","name":"thuenhanuoc.vn","slug":"thuenhanuoc-vn","taxonomy":"post_tag","_links":{"self":[{"href":"https://hopthu.vn/wp-json/wp/v2/tags/184","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://hopthu.vn/wp-json/wp/v2/tags"}],"about":[{"href":"https://hopthu.vn/wp-json/wp/v2/taxonomies/post_tag"}],"wp:post_type":[{"href":"https://hopthu.vn/wp-json/wp/v2/posts?tags=184"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]]}},{"id":9146,"date":"2023-04-17T09:34:34","date_gmt":"2023-04-17T09:34:34","guid":{"rendered":"https://hopthu.vn/?p=9146"},"modified":"2026-07-03T09:56:34","modified_gmt":"2026-07-03T09:56:34","slug":"hop-thu-huong-ung-phong-trao-hien-mau-nhan-dao-2023","status":"publish","type":"post","link":"https://hopthu.vn/2023/04/17/hop-thu-huong-ung-phong-trao-hien-mau-nhan-dao-2023/","title":{"rendered":"Hộp thư hưởng ứng phong trào hiến máu nhân đạo 2023"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\"><strong><em>Bên cạnh các hoạt động sản xuất kinh doanh, thời gian qua, <a href=\"https://tadu.cloud/gioi-thieu/\" title=\"Công Ty Cổ Phần Công Nghệ Tadu\">Công Ty Cổ Phần Công Nghệ Tadu</a> luôn chú trọng đến những hoạt động hướng về xã hội, vì cộng đồng</em></strong>, <strong><em>đặc biệt hoạt động là hiến máu nhân đạo.</em></strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">Hưởng ứng phong trào hiến máu cứu người được <a href=\"https://www.facebook.com/hoituvanvadlttphcm/\">Hội Đại lý Thuế</a> đề xuất, Ban lãnh đạo TADU đã động viên, khuyến khích toàn thể anh chị em nhân viên trong Công ty tích cực tham gia hiến máu nhân đạo để đóng góp cho ngân hàng máu.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>Xem thêm các hoạt động khác của Tadu:</em></p>\n\n\n\n<p class=\"wp-block-paragraph\">&gt;&gt;&gt;<a href=\"https://tadu.cloud/hoat-dong-cua-tadu-chao-mung-ngay-doanh-nhan-viet-nam-13-10/\" target=\"_blank\" rel=\"noopener\">Tadu Cloud chào mừng ngày doanh nhân Việt Nam 13-10</a></p>\n\n\n\n<p class=\"wp-block-paragraph\">&gt;&gt;&gt;<a href=\"https://tadu.cloud/tadu-vui-trung-thu-cung-mai-am-tan-binh-2022/\" target=\"_blank\" rel=\"noopener\">Tadu vui Trung Thu cùng Mái Ấm Tân Bình 2022</a></p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"575\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1024x575.jpg\" alt=\"\" class=\"wp-image-9147\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1024x575.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-300x169.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-768x431.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1536x863.jpg 1536w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-150x84.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703.jpg 1620w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">Đội ngũ Hộp thư cùng Đại lý Thuế Tấn Ngọc và Đại lý Thuế Người Trợ Lý (Atax)</figcaption></figure>\n</div>\n\n\n<p class=\"wp-block-paragraph\">Đối với mỗi công ty,&nbsp;<a href=\"https://tadu.cloud/email-doanh-nghiep/\" target=\"_blank\" rel=\"noreferrer noopener\">email doanh nghiệp</a>&nbsp;là một phần không thể thiếu trong hoạt động kinh doanh. Nó kiểm soát giao dịch, lưu trữ thông tin tài khoản quan trọng, những hợp động kí kết,…</p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://tadu.cloud/\" target=\"_blank\" rel=\"noreferrer noopener\">Tadu</a> quyết định cho ra mắt phần mềm <a href=\"https://hopthu.vn/\" target=\"_blank\" rel=\"noreferrer noopener\">Email doanh nghiệp</a> được phát triển dành riêng cho doanh nghiệp Việt Nam.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Với mục tiêu chiếm lĩnh thị trường trong nước và xây dựng thương hiệu vững mạnh. Nắm bắt được cơ hội lớn khi cuộc cách mạng công nghệ 4.0 diễn ra trên thế giới.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Tadu đã nghiên cứu và cho ra đời <a href=\"https://hopthu.vn/dang-ky-hop-thu/\" title=\"phần mềm Hộp thư doanh nghiệp\">phần mềm Hộp thư doanh nghiệp</a>. Khẳng định sự khởi đầu mạnh mẽ, khao khát Hộp thư sẽ trở thành một phần mềm quen thuộc và phổ biến đối với tất cả doanh nghiệp Việt.</p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-full is-resized\"><img decoding=\"async\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578.jpg\" alt=\"\" class=\"wp-image-9149\" width=\"950\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578.jpg 754w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578-300x168.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_135631_578-150x84.jpg 150w\" sizes=\"(max-width: 754px) 100vw, 754px\" /><figcaption class=\"wp-element-caption\">CEO Nguyễn Đức Dũng cùng anh/chị/em đội ngũ Hộp thư</figcaption></figure>\n</div>\n\n\n<p class=\"wp-block-paragraph\">Hiến máu tình nguyện là một việc làm rất ý nghĩa, thể hiện nghĩa cử cao đẹp và lòng nhân ái sâu sắc đối với cộng đồng. Song hành cùng với hoạt động kinh doanh, phong trào hiến máu tình nguyện chính là hoạt động an sinh xã hội có ý nghĩa thiết thực được Công ty TADU vô cùng hưởng ứng.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Xem thêm các hoạt động của Tadu Cloud:</p>\n\n\n\n<p class=\"wp-block-paragraph\">&gt;&gt;&gt; <a href=\"https://tadu.cloud/cong-nghe-nang-tam-cuoc-song-trien-lam-va-hoi-nghi-tech4life-2022/\" target=\"_blank\" rel=\"noopener\">Tadu tham gia Triển lãm và Hội nghị Tech4Life 2022</a></p>\n\n\n\n<p class=\"wp-block-paragraph\">Một số khoảnh khác vô cùng hạnh phúc của tập thể đội ngũ Hộp thư và các đối tác trong hoạt động hiến máu nhân đạo diễn ra ngày 14/04/2023 vừa qua.</p>\n\n\n\n<h2 class=\"wp-block-heading\">Hình ảnh Hộp thư tham gia hiến máu nhân đạo đóng góp vào ngân hàng máu quốc gia</h2>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-1 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"575\" data-id=\"9151\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132228_227-1024x575.jpg\" alt=\"\" class=\"wp-image-9151\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132228_227-1024x575.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132228_227-300x168.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132228_227-768x431.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132228_227-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132228_227-150x84.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132228_227.jpg 1387w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">Công tác chuẩn bị cho một sức khỏe tốt</figcaption></figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" data-id=\"9152\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_131514_792-1024x576.jpg\" alt=\"\" class=\"wp-image-9152\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_131514_792-1024x576.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131514_792-300x169.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131514_792-768x432.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131514_792-540x304.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131514_792-150x84.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131514_792.jpg 1354w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">Xác nhận thông tin cá nhân</figcaption></figure>\n</figure>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-2 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"575\" data-id=\"9153\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132029_035-1024x575.jpg\" alt=\"\" class=\"wp-image-9153\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132029_035-1024x575.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132029_035-300x169.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132029_035-768x431.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132029_035-1536x863.jpg 1536w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132029_035-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132029_035-150x84.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132029_035.jpg 1620w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">Công tác sau khi hiến máu xong</figcaption></figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"731\" data-id=\"9155\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_131231_319-1024x731.jpg\" alt=\"\" class=\"wp-image-9155\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_131231_319-1024x731.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131231_319-300x214.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131231_319-768x548.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131231_319-540x386.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131231_319-150x107.jpg 150w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_131231_319.jpg 1420w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /><figcaption class=\"wp-element-caption\">Hạnh phúc khi được trao đi yêu thương</figcaption></figure>\n</figure>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-3 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"575\" data-id=\"9156\" src=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1-1024x575.jpg\" alt=\"\" class=\"wp-image-9156\" srcset=\"https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1-1024x575.jpg 1024w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1-300x169.jpg 300w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1-768x431.jpg 768w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1-1536x863.jpg 1536w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1-540x303.jpg 540w, https://hopthu.vn/wp-content/uploads/2023/04/20230415_132608_703-1-150x84.jpg 150w, https://hopthu.vn/wp-conten