<div class="profile-layout">
    <!-- Hidden photo file input -->
    <input
        #photoFileInput
        type="file"
        accept="image/*"
        style="display: none"
        (change)="onPhotoSelected($event)"
    />
    <!-- Hidden avatar file input -->
    <input
        #avatarFileInput
        type="file"
        accept="image/*"
        style="display: none"
        (change)="onAvatarSelected($event)"
    />
    <!-- Hidden action GLB file input -->
    <input
        #actionFileInput
        type="file"
        accept=".glb"
        style="display: none"
        (change)="onActionFileSelected($event)"
    />
    <!-- Hidden PlayCanvas script file input -->
    <input
        #scriptFileInput
        type="file"
        accept=".js,text/javascript"
        style="display: none"
        (change)="onScriptFileSelected($event)"
    />
    <!-- Hidden audio file input -->
    <input
        #audioFileInput
        type="file"
        accept="audio/*"
        style="display: none"
        (change)="onAudioSelected($event)"
    />
    <!-- Hidden text file input -->
    <input
        #textFileInput
        type="file"
        accept=".txt,.json,.md,.srt,.vtt"
        style="display: none"
        (change)="onTextFileSelected($event)"
    />
    <!-- Hidden prop GLB file input (nhiều file cùng lúc) -->
    <input
        #propGlbFileInput
        type="file"
        accept=".glb"
        multiple
        style="display: none"
        (change)="onPropGlbSelected($event)"
    />

    <!-- LEFT SIDEBAR -->
    <div class="profile-sidebar" [class.is-collapsed]="isSidebarCollapsed">
        <div class="sidebar-header">
            <h2 class="sidebar-title">Căn phòng của {{ username }}</h2>
            <button
                mat-icon-button
                (click)="toggleSidebar()"
                class="sidebar-toggle-btn ml-auto"
                [matTooltip]="
                    isSidebarCollapsed ? 'Mở sidebar' : 'Thu gọn sidebar'
                "
            >
                <mat-icon class="icon-size-5">
                    {{ isSidebarCollapsed ? "menu" : "format_indent_decrease" }}
                </mat-icon>
            </button>
        </div>

        <div class="sidebar-body">
            <!-- NHÂN VẬT -->
            <div class="sidebar-section-label">Nhân vật</div>

            <!-- Upload zone khi chưa có character -->
            @if (!profile?.character?.glbPath) {
                <div
                    class="char-upload-zone"
                    (click)="triggerUpload()"
                    [class.is-uploading]="isUploading"
                >
                    <input
                        #glbFileInput
                        type="file"
                        accept=".glb"
                        style="display: none"
                        (change)="onGlbSelected($event)"
                    />
                    <div class="char-upload-zone-inner">
                        @if (!isUploading) {
                            <span class="char-upload-icon">🧍</span>
                            <span class="char-upload-title">Thêm nhân vật</span>
                            <span class="char-upload-hint"
                                >Nhấn để upload file .GLB</span
                            >
                        }
                        @if (isUploading) {
                            <div class="char-upload-spinner"></div>
                            <span class="char-upload-hint"
                                >Đang tải lên...</span
                            >
                        }
                    </div>
                </div>
            }

            <!-- Sau khi có character -->
            @if (profile?.character?.glbPath) {
                <div class="sidebar-char-card shrink-0">
                    <div
                        class="sidebar-char-avatar !w-10 !h-10 !min-w-[40px] !min-h-[40px] !max-w-[40px] !max-h-[40px] shrink-0 cursor-pointer relative group overflow-hidden rounded"
                        (click)="focusOnCharacter()"
                        matTooltip="Nhấn để đổi góc nhìn & ảnh đại diện"
                    >
                        @if (charThumbnail) {
                            <img
                                [src]="charThumbnail"
                                alt="avatar"
                                class="!w-10 !h-10 !max-w-[40px] !max-h-[40px] object-cover rounded block"
                            />
                        }
                        @if (!charThumbnail) {
                            <div
                                class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-500 to-teal-700 text-white font-bold text-base uppercase rounded shadow-inner"
                            >
                                {{
                                    (
                                        profile?.character?.name ||
                                        username ||
                                        "A"
                                    ).slice(0, 1)
                                }}
                            </div>
                        }
                        <div
                            class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white rounded"
                        >
                            <mat-icon class="icon-size-4"
                                >photo_camera</mat-icon
                            >
                        </div>
                    </div>
                    <div
                        class="sidebar-char-info cursor-pointer min-w-0 flex-1"
                        (click)="focusOnCharacter()"
                    >
                        <span class="sidebar-char-name truncate block">{{
                            profile?.character?.name || username
                        }}</span>
                        <span class="sidebar-char-sub truncate block">{{
                            profile?.character?.animationState || "Walk"
                        }}</span>
                    </div>
                    <input
                        #glbFileInput
                        type="file"
                        accept=".glb"
                        style="display: none"
                        (change)="onGlbSelected($event)"
                    />
                    <button
                        mat-icon-button
                        class="sidebar-char-replace shrink-0 ml-auto"
                        (click)="triggerUpload()"
                        title="Thay nhân vật"
                    >
                        <mat-icon>file_upload</mat-icon>
                    </button>
                </div>
            }

            <!-- Upload error -->
            @if (uploadError) {
                <div class="char-upload-error">⚠️ {{ uploadError }}</div>
            }

            <!-- ACCORDION MENU -->
            <div class="sidebar-accordion">
                <!-- ĐỒ VẬT -->
                <details class="sidebar-panel" open>
                    <summary class="sidebar-panel-header">
                        <span class="sidebar-panel-label"
                            >ĐỒ VẬT ({{ roomProps.length }})</span
                        >
                        <button
                            type="button"
                            class="props-reset-btn"
                            matTooltip="Xóa hết đồ vật đã thêm, trả về mặc định"
                            (click)="resetPropsToDefault($event)"
                        >
                            <mat-icon>restart_alt</mat-icon>
                            <span>Reset</span>
                        </button>
                        <mat-icon class="sidebar-panel-arrow"
                            >expand_more</mat-icon
                        >
                    </summary>

                    <!-- Search Bar chuẩn Angular Material mat-form-field -->
                    <div
                        class="px-2 py-1.5 border-b border-gray-100 dark:border-gray-800 bg-gray-50/60 dark:bg-gray-900/40"
                    >
                        <mat-form-field
                            class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                            [subscriptSizing]="'dynamic'"
                        >
                            <button
                                type="button"
                                mat-icon-button
                                matPrefix
                                [matMenuTriggerFor]="addMenu"
                                title="Thêm mới..."
                                [matTooltip]="'Thêm mới...'"
                                class="text-teal-600 dark:text-teal-400"
                            >
                                <mat-icon class="icon-size-3.5">add</mat-icon>
                            </button>

                            <input
                                matInput
                                type="text"
                                [(ngModel)]="propSearchQuery"
                                (ngModelChange)="onSearchChange()"
                                (input)="onSearchChange()"
                                placeholder="Tìm kiếm đồ vật..."
                                class="text-base"
                            />

                            @if (propSearchQuery) {
                                <button
                                    type="button"
                                    mat-icon-button
                                    matSuffix
                                    (click)="clearSearch()"
                                    class="text-gray-400"
                                >
                                    <mat-icon class="icon-size-3.5"
                                        >close</mat-icon
                                    >
                                </button>
                            }
                        </mat-form-field>
                    </div>

                    <div class="sidebar-sub-items">
                        @for (prop of filteredRoomProps; track prop) {
                            <!-- LEVEL 1: ĐỒ VẬT MẸ (STANDARD ITEM) -->
                            <div
                                class="sidebar-sub-item prop-card group cursor-pointer"
                                [class.prop-card--unused]="prop.visible === false"
                                [class.prop-card--used]="prop.visible !== false"
                                (click)="onPropClick(prop)"
                            >
                                <!-- Thumbnail preview lớn (GLB đã render offscreen) -->
                                @if (prop.thumbnail) {
                                    <img
                                        [src]="prop.thumbnail"
                                        [alt]="prop.name"
                                        class="prop-thumb"
                                        draggable="false"
                                    />
                                } @else if (prop.glbPath) {
                                    <div class="prop-thumb prop-thumb--empty">
                                        <mat-icon class="icon-size-6">view_in_ar</mat-icon>
                                    </div>
                                }
                                <div class="prop-card__info">
                                    <div class="prop-card__name-row">
                                        <span class="prop-card__name">{{ prop.name }}</span>
                                        <!-- Nút Thuộc tính & Phương thức hành động -->
                                        <button
                                            mat-icon-button
                                            class="prop-card__tune"
                                            (click)="$event.stopPropagation(); openPropInspector(prop)"
                                            title="Thuộc tính & Phương thức hành động"
                                        >
                                            <mat-icon
                                                class="icon-size-4 text-slate-400 hover:text-teal-600"
                                                >tune</mat-icon
                                            >
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <!-- LEVEL 2: THÀNH PHẦN CON (STANDARD ITEM INDENTED) -->
                            @if (
                                prop.subDevices && prop.subDevices.length > 0
                            ) {
                                @for (sub of prop.subDevices; track sub) {
                                    @if (isSubDeviceMatchingSearch(prop, sub)) {
                                        <div
                                            class="sidebar-sub-item prop-sub-row !pl-8 hover:bg-gray-50 flex items-center justify-between group cursor-pointer"
                                            [class.opacity-60]="
                                                sub.enabled === false ||
                                                prop.visible === false
                                            "
                                            (click)="
                                                openSubDeviceInspector(
                                                    prop,
                                                    sub,
                                                    $event
                                                )
                                            "
                                        >
                                            <span
                                                class="text-left truncate text-base font-normal flex-1 min-w-0 pr-2"
                                                [ngClass]="
                                                    sub.enabled === false ||
                                                    prop.visible === false
                                                        ? 'text-slate-400 dark:text-slate-500'
                                                        : 'text-slate-600 dark:text-slate-400'
                                                "
                                            >
                                                {{ sub.name }}
                                            </span>
                                            <div
                                                class="flex items-center space-x-1 shrink-0 ml-auto"
                                                (click)="
                                                    $event.stopPropagation()
                                                "
                                            >
                                                <!-- Nút Thuộc tính & Phương thức hành động cho subDevice -->
                                                <button
                                                    mat-icon-button
                                                    (click)="
                                                        openSubDeviceInspector(
                                                            prop,
                                                            sub,
                                                            $event
                                                        )
                                                    "
                                                    title="Thuộc tính & Phương thức hành động"
                                                    class="opacity-0 group-hover:opacity-100 transition-opacity"
                                                >
                                                    <mat-icon
                                                        class="icon-size-4 text-slate-400 hover:text-teal-600"
                                                        >tune</mat-icon
                                                    >
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        }

                        @if (filteredRoomProps.length === 0) {
                            <div
                                class="prop-empty-row p-3 text-xs text-gray-500 leading-relaxed"
                            >
                                Không tìm thấy đồ vật nào
                            </div>
                        }
                    </div>
                </details>

                <!-- TRÊN CANVAS: mọi item đang hiển thị trên canvas kết quả (đồ thường đã insert + bản sao nhân bản) -->
                <details class="sidebar-panel" [open]="canvasProps.length > 0 || fxEffects.length > 0">
                    <summary class="sidebar-panel-header">
                        <span class="sidebar-panel-label"
                            >CANVAS ({{ canvasProps.length }})</span
                        >
                        <button
                            type="button"
                            class="canvas-script-add-btn"
                            matTooltip="Chạy script JavaScript trên canvas"
                            aria-label="Chạy script JavaScript trên canvas"
                            (click)="onPickScriptFile(); $event.preventDefault(); $event.stopPropagation()"
                        >
                            <mat-icon class="canvas-script-add-icon">add</mat-icon>
                        </button>
                        <mat-icon class="sidebar-panel-arrow"
                            >expand_more</mat-icon
                        >
                    </summary>

                    <div class="sidebar-sub-items">
                        @for (prop of canvasProps; track prop) {
                            <div
                                class="sidebar-sub-item prop-card group cursor-pointer"
                                [class.prop-card--used]="prop.visible !== false"
                                [class.prop-card--selected]="prop.id === selectedPropId"
                                (click)="onPropClick(prop)"
                            >
                                @if (prop.thumbnail) {
                                    <img
                                        [src]="prop.thumbnail"
                                        [alt]="prop.name"
                                        class="prop-thumb"
                                        draggable="false"
                                    />
                                } @else if (prop.glbPath) {
                                    <div class="prop-thumb prop-thumb--empty">
                                        <mat-icon class="icon-size-6">view_in_ar</mat-icon>
                                    </div>
                                }
                                <div class="prop-card__info">
                                    <div class="prop-card__name-row">
                                        <span class="prop-card__name" [title]="prop.name">{{
                                            prop.name
                                        }}</span>
                                        <!-- Nút Thuộc tính & Phương thức hành động -->
                                        <button
                                            mat-icon-button
                                            class="prop-card__tune"
                                            (click)="$event.stopPropagation(); openPropInspector(prop)"
                                            title="Thuộc tính & Phương thức hành động"
                                        >
                                            <mat-icon
                                                class="icon-size-4 text-slate-400 hover:text-teal-600"
                                                >tune</mat-icon
                                            >
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (canvasProps.length === 0) {
                            <div
                                class="prop-empty-row p-3 text-xs text-gray-500 leading-relaxed"
                            >
                                Canvas chưa có đồ vật nào. Thêm từ menu ĐỒ VẬT, hoặc
                                chọn một món rồi bấm nhân bản (Duplicate).
                            </div>
                        }

                        <!-- CANVAS FX EFFECTS: rieng mot hang grid, ngan cach khoang cach voi danh sach do vat -->
                        <div class="fx-list-block">
                        @if (sceneService.fxEffects.length > 0) {
                            <div class="fx-list-sep"></div>
                            <div class="fx-list-title">Hiệu ứng script ({{ sceneService.fxEffects.length }})</div>
                        }
                        @for (fx of sceneService.fxEffects; track fx.id) {
                            <div
                                class="sidebar-sub-item prop-card group cursor-pointer"
                                [class.prop-card--selected]="fx.id === fxInspectingId"
                                (click)="openFxEffectInspector(fx.id)"
                                [title]="'Cấu hình hiệu ứng: ' + fx.name"
                            >
                                <div class="prop-thumb fx-thumb">
                                    <mat-icon class="icon-size-5">auto_awesome</mat-icon>
                                </div>
                                <div class="prop-card__info">
                                    <div class="prop-card__name-row">
                                        <mat-slide-toggle
                                            class="fx-enable-toggle"
                                            [checked]="fx.enabled !== false"
                                            (click)="$event.stopPropagation()"
                                            (change)="toggleFxEffect(fx, $event)"
                                            [matTooltip]="fx.enabled !== false ? 'Đang bật — bấm để tắt' : 'Đang tắt — bấm để bật'"
                                            > </mat-slide-toggle
                                        >
                                        <span class="prop-card__name" [class.prop-card__name--disabled]="fx.enabled === false" [title]="fx.name">{{ fx.name }}</span>
                                        <button
                                            mat-icon-button
                                            class="prop-card__tune"
                                            (click)="$event.stopPropagation(); openFxEffectInspector(fx.id)"
                                            title="Cấu hình thuộc tính hiệu ứng"
                                        >
                                            <mat-icon
                                                class="icon-size-4 text-slate-400 hover:text-teal-600"
                                                >tune</mat-icon
                                            >
                                        </button>
                                        <button
                                            mat-icon-button
                                            class="prop-card__tune"
                                            (click)="removeFxFromList(fx.id, $event)"
                                            title="Gỡ khỏi danh sách & dừng hiệu ứng"
                                        >
                                            <mat-icon
                                                class="icon-size-4 text-slate-400 hover:text-red-600"
                                                >delete</mat-icon
                                            >
                                        </button>
                                    </div>
                                    <div class="fx-file-name">{{ fx.fileName }}</div>
                                </div>
                            </div>
                        }
                        </div>
                    </div>
                </details>


            </div>

            <!-- Angular Material Sub-Menus -->
            <!-- Actions Sub-Menu -->
            <mat-menu
                #actionsMenu="matMenu"
                class="rounded-xl py-1 w-72"
                panelClass="faint-shadow-menu"
            >
                @for (anim of userAnimations; track anim) {
                    <div
                        mat-menu-item
                        (click)="setAnimation(anim.name, anim.glbPath)"
                        class="hover:bg-gray-50 flex items-center justify-between !px-3 min-w-0 gap-2"
                    >
                        <!-- Radio button chọn mặc định -->
                        <div
                            (click)="
                                setDefaultAnimation(
                                    $event,
                                    anim.name,
                                    anim.glbPath
                                )
                            "
                            class="flex items-center shrink-0 mr-2"
                            [title]="
                                profile?.character?.animationState === anim.name
                                    ? 'Đang là mặc định'
                                    : 'Chọn làm hành động mặc định'
                            "
                        >
                            <span
                                class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center transition-colors"
                                [class.border-teal-500]="
                                    profile?.character?.animationState ===
                                    anim.name
                                "
                                [class.bg-teal-500]="
                                    profile?.character?.animationState ===
                                    anim.name
                                "
                            >
                                @if (
                                    profile?.character?.animationState ===
                                    anim.name
                                ) {
                                    <span
                                        class="w-2 h-2 rounded-full bg-white"
                                    ></span>
                                }
                            </span>
                        </div>
                        <!-- Tên hành động (bấm vào để phát ngay) -->
                        <span
                            class="text-base font-medium overflow-hidden text-ellipsis whitespace-nowrap block shrink flex-1"
                            [title]="anim.name"
                            [class.text-teal-600]="
                                profile?.character?.animationState === anim.name
                            "
                        >
                            {{ anim.name }}
                        </span>
                        <!-- Bộ nút 3 chấm chuẩn Angular 1:1 icon-only -->
                        <div
                            class="flex items-center justify-end ml-auto shrink-0"
                            (click)="$event.stopPropagation()"
                        >
                            <button
                                mat-icon-button
                                [matMenuTriggerFor]="actionSubMenu"
                                disableRipple
                                title="Tùy chọn"
                            >
                                <mat-icon class="icon-size-5 text-gray-500"
                                    >more_vert</mat-icon
                                >
                            </button>
                            <mat-menu
                                #actionSubMenu="matMenu"
                                class="rounded-xl py-1 min-w-[180px]"
                                panelClass="faint-shadow-menu"
                            >
                                <button
                                    mat-menu-item
                                    (click)="openActionConfig($event, anim)"
                                    class="hover:bg-gray-50"
                                >
                                    <mat-icon
                                        class="icon-size-5 text-teal-600 mr-2.5"
                                        >tune</mat-icon
                                    >
                                    <span class="text-base font-medium"
                                        >Chỉnh sửa</span
                                    >
                                </button>
                                <button
                                    mat-menu-item
                                    (click)="deleteAction($event, anim.id)"
                                    class="hover:bg-red-50 text-red-600"
                                >
                                    <mat-icon
                                        class="icon-size-5 text-red-600 mr-2.5"
                                        >delete_outline</mat-icon
                                    >
                                    <span class="text-base font-medium"
                                        >Xoá hành động</span
                                    >
                                </button>
                            </mat-menu>
                        </div>
                    </div>
                }

                @if (userAnimations.length === 0) {
                    <button mat-menu-item disabled>
                        <span class="text-base text-gray-400 font-normal"
                            >Chưa có hành động nào</span
                        >
                    </button>
                }
                <mat-divider></mat-divider>
                <button
                    mat-menu-item
                    (click)="triggerAddAction()"
                    class="hover:bg-teal-50 text-teal-600"
                >
                    <mat-icon class="icon-size-6 text-teal-600 mr-2.5"
                        >add_circle_outline</mat-icon
                    >
                    <span class="text-base font-semibold"
                        >Thêm hành động...</span
                    >
                </button>
            </mat-menu>

            <!-- Clothes Sub-Menu -->
            <mat-menu
                #clothesMenu="matMenu"
                class="rounded-xl py-1 w-64"
                panelClass="faint-shadow-menu"
            >
                <button mat-menu-item class="hover:bg-gray-50">
                    <mat-icon class="icon-size-5 text-teal-600 mr-2.5"
                        >checkroom</mat-icon
                    >
                    <span class="text-base font-medium">Mặc định</span>
                </button>
                <button mat-menu-item class="hover:bg-gray-50">
                    <mat-icon class="icon-size-5 text-teal-600 mr-2.5"
                        >checkroom</mat-icon
                    >
                    <span class="text-base font-medium">Áo phông đen</span>
                </button>
                <mat-divider></mat-divider>
                <button
                    mat-menu-item
                    (click)="triggerUpload()"
                    class="hover:bg-teal-50 text-teal-600"
                >
                    <mat-icon class="icon-size-6 text-teal-600 mr-2.5"
                        >add_circle_outline</mat-icon
                    >
                    <span class="text-base font-semibold"
                        >Thêm trang phục...</span
                    >
                </button>
            </mat-menu>

            <!-- Add Menu (Thêm mới đồ vật GLB) -->
            <mat-menu
                #addMenu="matMenu"
                class="rounded-xl py-1 w-56"
                panelClass="faint-shadow-menu"
            >
                <button
                    mat-menu-item
                    (click)="triggerAddPropGlb()"
                    class="hover:bg-teal-50 text-slate-700 hover:text-teal-700"
                >
                    <mat-icon class="icon-size-5 text-teal-600 mr-2.5"
                        >view_in_ar</mat-icon
                    >
                    <span class="text-base font-medium">Upload GLB</span>
                </button>
                <mat-divider></mat-divider>
                <button
                    mat-menu-item
                    (click)="triggerAddProp()"
                    class="hover:bg-teal-50 text-teal-600"
                >
                    <mat-icon class="icon-size-5 text-teal-600 mr-2.5"
                        >add_circle_outline</mat-icon
                    >
                    <span class="text-base font-semibold">Thêm đồ vật...</span>
                </button>
            </mat-menu>
        </div>

        <!-- Hidden input for prompt image attachments -->
        <input
            #promptFileInput
            type="file"
            accept="image/*,.js,text/javascript,application/javascript"
            multiple
            class="hidden"
            (change)="onPromptFileSelected($event)"
        />

        <!-- SIDEBAR FOOTER: Prompt Input -->
        <div class="sidebar-footer">
            <!-- Attached Props Tag Pills Bar -->
            @if (attachedProps.length > 0) {
                <div
                    class="flex flex-wrap gap-1.5 p-2 bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800"
                >
                    @for (prop of attachedProps; track prop; let i = $index) {
                        <div
                            class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full bg-teal-50 dark:bg-teal-900/40 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800 text-xs font-semibold"
                        >
                            <span class="text-teal-600 dark:text-teal-400"
                                >&#64;</span
                            >
                            <span class="truncate max-w-[120px]">{{
                                prop.name
                            }}</span>
                            <button
                                (click)="removeAttachedProp(i)"
                                class="text-teal-500 hover:text-teal-700 ml-1 focus:outline-none"
                            >
                                <mat-icon class="icon-size-3">close</mat-icon>
                            </button>
                        </div>
                    }
                </div>
            }

            <!-- Attached Script Chips Bar (JS hieu ung PlayCanvas) -->
            @if (attachedScripts.length > 0) {
                <div class="flex flex-wrap gap-2 p-3 pt-0">
                    @for (sc of attachedScripts; track sc.name; let i = $index) {
                        <div
                            class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg bg-violet-50 dark:bg-violet-900/40 text-violet-700 dark:text-violet-300 border border-violet-200 dark:border-violet-800 text-xs font-semibold"
                        >
                            <mat-icon class="icon-size-3.5 text-violet-500">code</mat-icon>
                            <span class="truncate max-w-[160px]">{{ sc.name }}</span>
                            <span class="text-violet-400 font-normal">{{ sc.size < 1024 ? sc.size + ' B' : (sc.size / 1024).toFixed(1) + ' KB' }}</span>
                            <button
                                (click)="removeAttachedScript(i)"
                                class="text-violet-400 hover:text-violet-700 ml-1 focus:outline-none"
                            >
                                <mat-icon class="icon-size-3">close</mat-icon>
                            </button>
                        </div>
                    }
                </div>
            }

            <!-- Attached Image Thumbnails Bar -->
            @if (attachedImages.length > 0) {
                <div class="flex flex-wrap gap-2.5 p-3">
                    @for (img of attachedImages; track img; let i = $index) {
                        <div
                            class="relative group w-12 h-12 rounded-xl overflow-hidden shadow-sm bg-slate-100 flex-shrink-0"
                        >
                            <img
                                [src]="img.dataUrl"
                                class="w-full h-full object-cover"
                            />
                            <button
                                (click)="removeAttachedImage(i)"
                                class="absolute top-0.5 right-0.5 w-4 h-4 rounded-full bg-slate-900/80 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                            >
                                <svg
                                    width="10"
                                    height="10"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="3"
                                >
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="sidebar-prompt-bar relative">
                <!-- Floating Angular Material @mention Autocomplete Popup Menu -->
                @if (showMentionMenu) {
                    <div
                        class="absolute bottom-full left-3 w-64 mb-1.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg z-[99999] overflow-hidden"
                    >
                        <mat-action-list
                            class="!py-0 max-h-44 overflow-y-auto custom-scrollbar"
                        >
                            @for (
                                prop of filteredMentionProps;
                                track prop;
                                let i = $index
                            ) {
                                <button
                                    mat-list-item
                                    (click)="selectMentionProp(prop)"
                                    [ngClass]="{
                                        'bg-teal-50 dark:bg-teal-900/30':
                                            i === mentionSelectedIndex,
                                    }"
                                    class="!h-8.5 !min-h-0 hover:bg-teal-50/70 transition-colors px-3"
                                >
                                    <span
                                        matListItemTitle
                                        class="text-base font-medium text-slate-800 dark:text-slate-100 truncate block"
                                        >{{
                                            prop.displayName || prop.name
                                        }}</span
                                    >
                                </button>
                            }
                        </mat-action-list>
                    </div>
                }

                <textarea
                    #promptInputArea
                    class="sidebar-prompt-input"
                    placeholder="Tiếp tục chỉnh sửa... (gõ @ để chọn đồ vật, Ctrl+V dán ảnh)"
                    [(ngModel)]="promptText"
                    (input)="onPromptInput($event)"
                    (keydown)="onPromptKeydown($event)"
                    (paste)="onPromptPaste($event)"
                    [disabled]="isProcessingPrompt"
                    [class.opacity-50]="isProcessingPrompt"
                    [class.cursor-not-allowed]="isProcessingPrompt"
                    rows="2"
                    cdkTextareaAutosize
                    cdkAutosizeMinRows="2"
                    cdkAutosizeMaxRows="5"
                ></textarea>

                <!-- Right Action Buttons Stack (Attach & Send) -->
                <div class="sidebar-prompt-actions">
                    <button
                        mat-icon-button
                        class="sidebar-prompt-attach"
                        title="Đính kèm ảnh hoặc tệp JS hiệu ứng (Ctrl+V dán ảnh)"
                        (click)="triggerPromptFileUpload()"
                        [disabled]="isProcessingPrompt"
                    >
                        @if (!isProcessingPrompt) {
                            <mat-icon class="icon-size-4">attach_file</mat-icon>
                        }
                        @if (isProcessingPrompt) {
                            <mat-icon
                                class="icon-size-4 text-teal-600 animate-spin"
                                >sync</mat-icon
                            >
                        }
                    </button>
                    <button
                        mat-icon-button
                        class="sidebar-prompt-send"
                        title="Gửi yêu cầu (Enter)"
                        (click)="sendPrompt()"
                        [disabled]="isProcessingPrompt || (!promptText?.trim() && !hasAnyAttachment())"
                    >
                        <mat-icon class="icon-size-4">arrow_upward</mat-icon>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT: 3D SCENE -->
    <div class="profile-scene-wrap">
        <!-- Inner padded container — canvas fills this, not the outer wrap -->
        <div class="scene-inner" #sceneContainer>
            <!-- Floating Sidebar Re-open Button (Top-Left, visible when sidebar collapsed) -->
            @if (isSidebarCollapsed) {
                <button
                    mat-icon-button
                    (click)="toggleSidebar()"
                    class="floating-sidebar-toggle-btn"
                    matTooltip="Mở sidebar"
                >
                    <mat-icon class="icon-size-5"
                        >format_indent_increase</mat-icon
                    >
                </button>
            }

            <!-- Floating Scene Toolbar (Top-Right) -->
            <div class="scene-floating-toolbar">
                <!-- 1. Full Screen -->
                <button
                    mat-icon-button
                    (click)="toggleFullScreen()"
                    class="scene-toolbar-btn"
                    [matTooltip]="
                        isFullscreen ? 'Thoát toàn màn hình' : 'Toàn màn hình'
                    "
                >
                    <mat-icon>{{
                        isFullscreen ? "fullscreen_exit" : "fullscreen"
                    }}</mat-icon>
                </button>

                <!-- 2. Reload -->
                <button
                    mat-icon-button
                    (click)="reloadScene()"
                    class="scene-toolbar-btn"
                    matTooltip="Tải lại 3D Scene"
                >
                    <mat-icon>refresh</mat-icon>
                </button>

                <!-- 3. Record / Export Video -->
                <button
                    mat-icon-button
                    (click)="toggleVideoRecording()"
                    class="scene-toolbar-btn"
                    [class.scene-toolbar-btn--recording]="isRecording"
                    [class.scene-toolbar-btn--primary]="!isRecording"
                    [matTooltip]="
                        isRecording
                            ? 'Dừng & Lưu Video'
                            : 'Bắt đầu Quay & Xuất Video'
                    "
                >
                    <mat-icon>{{ isRecording ? "stop" : "videocam" }}</mat-icon>
                </button>
            </div>

            <!-- Loading Overlay -->
            @if (isLoading) {
                <div class="sontinh-loading-overlay">
                    <div class="sontinh-loading-content">
                        <div class="sontinh-spinner"></div>
                        <p class="sontinh-loading-text">
                            Đang tải Căn phòng của {{ username }}...
                        </p>
                    </div>
                </div>
            }

            <!-- Error State -->
            @if (loadError && !isLoading) {
                <div class="sontinh-error-overlay">
                    <div class="sontinh-error-content">
                        <span class="sontinh-error-icon">⚠️</span>
                        <p class="sontinh-error-text">{{ loadError }}</p>
                    </div>
                </div>
            }

            <!-- 3D Scene Canvas -->
            <canvas
                #sceneCanvas
                id="application-canvas"
                class="sontinh-canvas"
            ></canvas>

            <!-- Nút Delete/Duplicate nổi cạnh đồ vật đang chọn (bám ring qua callback anchor) -->
            @if (propActionAnchor.visible && propActionAnchor.propId) {
                <div
                    class="sontinh-prop-actions"
                    [style.left.px]="propActionAnchor.x"
                    [style.top.px]="propActionAnchor.y"
                >
                    <button
                        type="button"
                        class="sontinh-prop-actions__btn sontinh-prop-actions__btn--dup"
                        title="Nhân bản đồ vật này (bản sao đặt cạnh)"
                        (pointerdown)="onCanvasDuplicateProp($event)"
                    >
                        <mat-icon>content_copy</mat-icon>
                    </button>
                    <button
                        type="button"
                        class="sontinh-prop-actions__btn sontinh-prop-actions__btn--del"
                        title="Gỡ đồ vật này khỏi canvas (giữ trong menu ĐỒ VẬT)"
                        (pointerdown)="onCanvasDeleteProp($event)"
                    >
                        <mat-icon>delete</mat-icon>
                    </button>
                </div>
            }

            <!-- Selection XYZ overlay: trục + tọa độ đồ vật đang chọn -->
            @if (selectedPropId && selectedPropPos) {
                <div class="sontinh-axes-info">
                    <div class="sontinh-axes-info__name">{{ selectedPropName }}</div>
                    <div class="sontinh-axes-info__sec">Vị trí</div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--x">X</span>
                        <span class="sontinh-axes-info__val">{{ selectedPropPos.x.toFixed(2) }}</span>
                    </div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--y">Y</span>
                        <span class="sontinh-axes-info__val">{{ selectedPropPos.y.toFixed(2) }}</span>
                    </div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--z">Z</span>
                        <span class="sontinh-axes-info__val">{{ selectedPropPos.z.toFixed(2) }}</span>
                    </div>
                    <div class="sontinh-axes-info__scrub">
                        <button
                            type="button"
                            class="sontinh-axes-scrub sontinh-axes-scrub--x"
                            title="Kéo ngang để chỉnh trục X"
                            (pointerdown)="onTransformScrubStart('pos', 0, $event)"
                        >
                            <span class="sontinh-axes-scrub__label">X</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                        <button
                            type="button"
                            class="sontinh-axes-scrub sontinh-axes-scrub--y"
                            title="Kéo dọc để chỉnh trục Y"
                            (pointerdown)="onTransformScrubStart('pos', 1, $event)"
                        >
                            <span class="sontinh-axes-scrub__label">Y</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                        <button
                            type="button"
                            class="sontinh-axes-scrub sontinh-axes-scrub--z"
                            title="Kéo ngang để chỉnh trục Z"
                            (pointerdown)="onTransformScrubStart('pos', 2, $event)"
                        >
                            <span class="sontinh-axes-scrub__label">Z</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                    </div>
                    <div class="sontinh-axes-info__sec">Góc xoay (&deg;)</div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--x">X</span>
                        <span class="sontinh-axes-info__val">{{ (selectedPropRot?.x ?? 0).toFixed(1) }}</span>
                    </div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--y">Y</span>
                        <span class="sontinh-axes-info__val">{{ (selectedPropRot?.y ?? 0).toFixed(1) }}</span>
                    </div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--z">Z</span>
                        <span class="sontinh-axes-info__val">{{ (selectedPropRot?.z ?? 0).toFixed(1) }}</span>
                    </div>
                    <div class="sontinh-axes-info__scrub">
                        <button type="button" class="sontinh-axes-scrub sontinh-axes-scrub--x" title="Kéo ngang để xoay quanh trục X" (pointerdown)="onTransformScrubStart('rot', 0, $event)">
                            <span class="sontinh-axes-scrub__label">X</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                        <button type="button" class="sontinh-axes-scrub sontinh-axes-scrub--y sontinh-axes-scrub--h" title="Kéo ngang để xoay quanh trục Y" (pointerdown)="onTransformScrubStart('rot', 1, $event)">
                            <span class="sontinh-axes-scrub__label">Y</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                        <button type="button" class="sontinh-axes-scrub sontinh-axes-scrub--z" title="Kéo ngang để xoay quanh trục Z" (pointerdown)="onTransformScrubStart('rot', 2, $event)">
                            <span class="sontinh-axes-scrub__label">Z</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                    </div>
                    <div class="sontinh-axes-info__sec">Scale</div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--x">X</span>
                        <span class="sontinh-axes-info__val">{{ (selectedPropScl?.x ?? 1).toFixed(2) }}</span>
                    </div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--y">Y</span>
                        <span class="sontinh-axes-info__val">{{ (selectedPropScl?.y ?? 1).toFixed(2) }}</span>
                    </div>
                    <div class="sontinh-axes-info__row">
                        <span class="sontinh-axes-info__axis sontinh-axes-info__axis--z">Z</span>
                        <span class="sontinh-axes-info__val">{{ (selectedPropScl?.z ?? 1).toFixed(2) }}</span>
                    </div>
                    <div class="sontinh-axes-info__scrub">
                        <button type="button" class="sontinh-axes-scrub sontinh-axes-scrub--x" title="Kéo ngang để scale trục X" (pointerdown)="onTransformScrubStart('scl', 0, $event)">
                            <span class="sontinh-axes-scrub__label">X</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                        <button type="button" class="sontinh-axes-scrub sontinh-axes-scrub--y sontinh-axes-scrub--h" title="Kéo ngang để scale trục Y" (pointerdown)="onTransformScrubStart('scl', 1, $event)">
                            <span class="sontinh-axes-scrub__label">Y</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                        <button type="button" class="sontinh-axes-scrub sontinh-axes-scrub--z" title="Kéo ngang để scale trục Z" (pointerdown)="onTransformScrubStart('scl', 2, $event)">
                            <span class="sontinh-axes-scrub__label">Z</span>
                            <span class="sontinh-axes-scrub__arrows">
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--l"></i>
                                <i class="sontinh-axes-scrub__tip sontinh-axes-scrub__tip--r"></i>
                            </span>
                        </button>
                    </div>
                    <div class="sontinh-axes-info__hint">Kéo nút mũi tên để chỉnh &middot; thả ra để lưu</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Cấu hình hành động -->
@if (editingAction) {
    <div
        class="fixed inset-0 z-[99999] flex items-center justify-center bg-slate-900/60 backdrop-blur-md p-4"
    >
        <div
            class="bg-white rounded-sm border border-gray-100 p-6 w-full max-w-md animate-in fade-in zoom-in-95 duration-150"
        >
            <div
                class="flex items-center justify-between border-b border-gray-100 pb-3 mb-4"
            >
                <h3
                    class="text-base font-bold text-gray-800 flex items-center gap-2"
                >
                    <mat-icon class="text-teal-600">tune</mat-icon>
                    Cấu hình hành động
                </h3>
                <button mat-icon-button (click)="closeActionConfig()">
                    <mat-icon>close</mat-icon>
                </button>
            </div>
            <div class="space-y-4">
                <!-- Tên hành động -->
                <div>
                    <label
                        class="block text-base font-semibold text-gray-600 mb-1"
                        >Tên hành động</label
                    >
                    <input
                        type="text"
                        [(ngModel)]="editingAction.name"
                        class="w-full px-3 py-2 border border-gray-200 rounded-sm text-base focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500"
                    />
                </div>
                <!-- Loại hành động: Di chuyển vs Tại chỗ -->
                <div>
                    <label
                        class="block text-base font-semibold text-gray-600 mb-2"
                        >Loại chuyển động</label
                    >
                    <div class="grid grid-cols-2 gap-3">
                        <button
                            type="button"
                            (click)="editingAction.isMovement = false"
                            [class.border-teal-500]="!editingAction.isMovement"
                            [class.bg-teal-50]="!editingAction.isMovement"
                            [class.text-teal-700]="!editingAction.isMovement"
                            class="p-3 border rounded-sm flex flex-col items-center gap-1.5 transition-all text-gray-600 border-gray-200 hover:border-teal-200"
                        >
                            <mat-icon class="icon-size-5"
                                >accessibility_new</mat-icon
                            >
                            <span class="text-base font-semibold">Tại chỗ</span>
                            <span class="text-base text-gray-400"
                                >Đứng/Nhảy/Dance</span
                            >
                        </button>
                        <button
                            type="button"
                            (click)="editingAction.isMovement = true"
                            [class.border-teal-500]="editingAction.isMovement"
                            [class.bg-teal-50]="editingAction.isMovement"
                            [class.text-teal-700]="editingAction.isMovement"
                            class="p-3 border rounded-sm flex flex-col items-center gap-1.5 transition-all text-gray-600 border-gray-200 hover:border-teal-200"
                        >
                            <mat-icon class="icon-size-5"
                                >directions_walk</mat-icon
                            >
                            <span class="text-base font-semibold"
                                >Di chuyển</span
                            >
                            <span class="text-base text-gray-400"
                                >Đi bộ/Chạy</span
                            >
                        </button>
                    </div>
                </div>
                <!-- Tốc độ di chuyển (chỉ hiện khi là loại Di chuyển) -->
                @if (editingAction.isMovement) {
                    <div>
                        <label
                            class="block text-base font-semibold text-gray-600 mb-1"
                        >
                            Tốc độ di chuyển:
                            <span class="text-teal-600 font-bold"
                                >{{ editingAction.speed || 1 }}x</span
                            >
                        </label>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-gray-400"
                                >Chậm (0.2x)</span
                            >
                            <input
                                type="range"
                                min="0.2"
                                max="3.0"
                                step="0.1"
                                [(ngModel)]="editingAction.speed"
                                class="w-full accent-teal-600"
                            />
                            <span class="text-xs text-gray-400"
                                >Nhanh (3x)</span
                            >
                        </div>
                    </div>
                }
            </div>
            <div
                class="flex justify-end gap-2 border-t border-gray-100 pt-4 mt-6"
            >
                <button mat-button (click)="closeActionConfig()">Hủy</button>
                <button
                    mat-flat-button
                    color="primary"
                    (click)="saveActionConfig()"
                    class="bg-teal-600 text-white"
                >
                    Lưu cấu hình
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL CẤU HÌNH THUỘC TÍNH & PHƯƠNG THỨC HÀNH ĐỘNG ĐỒ VẬT 3D -->
@if (fxInspecting) {
    <div
        class="fixed inset-0 z-[99999] flex items-center justify-center p-4 sm:p-6 bg-slate-900/60 backdrop-blur-sm animate-fade-in"
    >
        <div
            class="bg-white dark:bg-slate-900 rounded-2xl w-full max-w-[560px] max-h-[calc(90vh-48px)] flex flex-col p-6 overflow-hidden text-base shadow-2xl"
        >
            <!-- Header (chuẩn style dialog Chỉnh sửa tên miền) -->
            <div class="shrink-0 pb-2">
                <div class="flex items-center justify-between mb-3">
                    <div
                        class="flex items-center gap-2 text-xl font-bold text-gray-800 dark:text-gray-100"
                    >
                        <mat-icon
                            class="text-emerald-500 icon-size-6"
                            [svgIcon]="'heroicons_outline:sparkles'"
                        ></mat-icon>
                        <span>{{ fxInspecting.name }}</span>
                    </div>
                    <button
                        type="button"
                        mat-icon-button
                        (click)="closeFxEffectInspector()"
                        class="bg-gray-100 dark:bg-gray-800 text-gray-500 hover:text-gray-700 hover:bg-gray-200 dark:hover:bg-gray-700 dark:text-gray-400"
                        title="Đóng"
                    >
                        <mat-icon
                            class="icon-size-5"
                            [svgIcon]="'heroicons_outline:x'"
                        ></mat-icon>
                    </button>
                </div>

                <p
                    class="text-base text-gray-600 dark:text-gray-400 mb-6 leading-relaxed"
                >
                    {{ fxInspecting.fileName }}
                </p>
            </div>

            <!-- Body (Scrollable): control sinh ĐỘNG theo type từng thuộc tính script -->
            <div
                class="flex-1 overflow-y-auto pr-1 flex flex-col gap-4 custom-scrollbar"
            >
                @if (fxInspecting.paramsMeta.length === 0) {
                    <div class="text-sm text-gray-500 dark:text-gray-400">
                        Script này không khai báo thuộc tính cấu hình nào (attributes.add). Không có gì để tùy chỉnh.
                    </div>
                }
                @for (p of fxInspecting.paramsMeta; track p.name) {
                    <div class="fx-param-row">
                        <label class="fx-param-label" [title]="p.name">
                            <span class="fx-param-title">{{ p.title || p.name }}</span>
                            <span class="fx-param-name">{{ p.name }} · {{ p.type }}</span>
                        </label>

                        @switch (p.type) {
                            @case ('boolean') {
                                <mat-checkbox
                                    [checked]="!!fxInspecting.params[p.name]"
                                    (change)="fxInspecting.params[p.name] = $event.checked"
                                >Bật</mat-checkbox>
                            }
                            @case ('rgb') {
                                <div class="fx-param-inline">
                                    <input
                                        type="color"
                                        class="fx-color-input"
                                        [value]="fxColorDrafts[p.name] || '#ffffff'"
                                        (input)="onFxColorChange(p.name, $any($event.target).value)"
                                    />
                                    <span class="fx-color-hex">{{ fxColorDrafts[p.name] }}</span>
                                </div>
                            }
                            @case ('rgba') {
                                <div class="fx-param-inline">
                                    <input
                                        type="color"
                                        class="fx-color-input"
                                        [value]="fxColorDrafts[p.name] || '#ffffff'"
                                        (input)="onFxColorChange(p.name, $any($event.target).value)"
                                    />
                                    <span class="fx-color-hex">{{ fxColorDrafts[p.name] }}</span>
                                </div>
                                <div class="fx-param-inline fx-param-slider">
                                    <span class="fx-param-slider-label">Độ mờ</span>
                                    <input
                                        type="range"
                                        min="0"
                                        max="1"
                                        step="0.05"
                                        [value]="fxInspecting.params[p.name]?.a ?? 1"
                                        (input)="fxInspecting.params[p.name].a = $any($event.target).valueAsNumber"
                                    />
                                    <span class="fx-slider-val">{{ (fxInspecting.params[p.name]?.a ?? 1) | number: '1.2-2' }}</span>
                                </div>
                            }
                            @case ('vec3') {
                                <div class="fx-vec-grid">
                                    @for (ax of ['X', 'Y', 'Z']; track ax) {
                                        <mat-form-field class="fuse-mat-dense fuse-mat-emphasized-affix w-full" [subscriptSizing]="'dynamic'">
                                            <mat-label>{{ ax }}</mat-label>
                                            <input
                                                matInput
                                                type="number"
                                                [value]="fxInspecting.params[p.name]?.data?.[$index] ?? 0"
                                                (input)="fxInspecting.params[p.name].data[$index] = $any($event.target).valueAsNumber || 0"
                                            />
                                        </mat-form-field>
                                    }
                                </div>
                            }
                            @case ('vec2') {
                                <div class="fx-vec-grid fx-vec-grid--2">
                                    @for (ax of ['X', 'Y']; track ax) {
                                        <mat-form-field class="fuse-mat-dense fuse-mat-emphasized-affix w-full" [subscriptSizing]="'dynamic'">
                                            <mat-label>{{ ax }}</mat-label>
                                            <input
                                                matInput
                                                type="number"
                                                [value]="fxInspecting.params[p.name]?.data?.[$index] ?? 0"
                                                (input)="fxInspecting.params[p.name].data[$index] = $any($event.target).valueAsNumber || 0"
                                            />
                                        </mat-form-field>
                                    }
                                </div>
                            }
                            @case ('vec4') {
                                <div class="fx-vec-grid fx-vec-grid--4">
                                    @for (ax of ['X', 'Y', 'Z', 'W']; track ax) {
                                        <mat-form-field class="fuse-mat-dense fuse-mat-emphasized-affix w-full" [subscriptSizing]="'dynamic'">
                                            <mat-label>{{ ax }}</mat-label>
                                            <input
                                                matInput
                                                type="number"
                                                [value]="fxInspecting.params[p.name]?.data?.[$index] ?? 0"
                                                (input)="fxInspecting.params[p.name].data[$index] = $any($event.target).valueAsNumber || 0"
                                            />
                                        </mat-form-field>
                                    }
                                </div>
                            }
                            @case ('string') {
                                <mat-form-field class="fuse-mat-dense fuse-mat-emphasized-affix w-full" [subscriptSizing]="'dynamic'">
                                    <input
                                        matInput
                                        type="text"
                                        [value]="fxInspecting.params[p.name] || ''"
                                        (input)="fxInspecting.params[p.name] = $any($event.target).value"
                                    />
                                </mat-form-field>
                            }
                            @default {
                                <mat-form-field class="fuse-mat-dense fuse-mat-emphasized-affix w-full" [subscriptSizing]="'dynamic'">
                                    <input
                                        matInput
                                        type="number"
                                        [value]="fxInspecting.params[p.name] ?? 0"
                                        (input)="fxInspecting.params[p.name] = $any($event.target).valueAsNumber || 0"
                                    />
                                </mat-form-field>
                            }
                        }
                    </div>
                }
            </div>

            <!-- Footer (chuẩn style dialog Chỉnh sửa tên miền) -->
            <div class="shrink-0 flex items-center justify-end gap-3 mt-6">
                <button
                    mat-button
                    (click)="closeFxEffectInspector()"
                    class="text-gray-600 dark:text-gray-300 font-medium"
                >
                    Hủy
                </button>
                <button
                    mat-flat-button
                    [color]="'primary'"
                    (click)="saveFxEffectConfig()"
                >
                    <mat-icon
                        class="icon-size-5"
                        [svgIcon]="'heroicons_outline:refresh'"
                    ></mat-icon>
                    <mat-label class="ml-2">Áp dụng &amp; chạy lại</mat-label>
                </button>
            </div>
        </div>
    </div>
}

@if (inspectingProp) {
    <div
        class="fixed inset-0 z-[99999] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in"
    >
        <div
            class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden text-base"
        >
            <!-- Header -->
            <div
                class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 shrink-0"
            >
                <h2
                    class="text-lg font-bold tracking-tight m-0 text-slate-800 dark:text-slate-100 truncate pr-2"
                >
                    {{ inspectingProp.name }}
                </h2>
                <button
                    mat-icon-button
                    (click)="inspectingProp = null"
                    title="Đóng"
                >
                    <mat-icon class="icon-size-5">close</mat-icon>
                </button>
            </div>
            <!-- Body (Strictly constrained scroll area) -->
            <div
                class="px-6 py-4 space-y-4 overflow-y-auto flex-1 custom-scrollbar text-base"
            >
                <!-- FORM INPUTS -->
                <div class="space-y-4 text-base">
                    <!-- SECTION 1: Thông tin chung & Phân loại -->
                    <div class="space-y-3">
                        <div
                            class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-2"
                        >
                            Thông tin chung
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label>Danh mục (Category)</mat-label>
                                <input
                                    matInput
                                    type="text"
                                    [(ngModel)]="inspectingProp.category"
                                    placeholder="Nhập phân loại đồ vật..."
                                    class="text-base"
                                />
                            </mat-form-field>
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label>Tên hiển thị</mat-label>
                                <input
                                    matInput
                                    type="text"
                                    [(ngModel)]="inspectingProp.name"
                                    class="text-base"
                                />
                            </mat-form-field>
                        </div>
                        <mat-form-field
                            class="fuse-mat-dense fuse-mat-emphasized-affix w-full mt-3"
                            [subscriptSizing]="'dynamic'"
                        >
                            <mat-label>Mô tả chi tiết đồ vật</mat-label>
                            <input
                                matInput
                                type="text"
                                [(ngModel)]="inspectingProp.description"
                                placeholder="Nhập mô tả đồ vật..."
                                class="text-base font-normal"
                            />
                        </mat-form-field>
                    </div>
                    <!-- SECTION 2: Tọa độ 3D Position -->
                    @if (inspectingProp.position) {
                        <div>
                            <div
                                class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-2"
                            >
                                Tọa độ 3D Position (X, Y, Z)
                            </div>
                            <div class="grid grid-cols-3 gap-3">
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Trục X</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="inspectingProp.position.x"
                                        class="text-base"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Trục Y (Cao)</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="inspectingProp.position.y"
                                        class="text-base"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Trục Z</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="inspectingProp.position.z"
                                        class="text-base"
                                    />
                                </mat-form-field>
                            </div>
                        </div>
                    }
                    <!-- SECTION 3: Góc xoay 3D Rotation -->
                    @if (inspectingProp.rotation) {
                        <div>
                            <div
                                class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-2"
                            >
                                Góc xoay 3D Rotation (Roll, Pitch, Yaw °)
                            </div>
                            <div class="grid grid-cols-3 gap-3">
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Roll °</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="1"
                                        [(ngModel)]="inspectingProp.rotation.x"
                                        class="text-base"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Pitch °</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="1"
                                        [(ngModel)]="inspectingProp.rotation.y"
                                        class="text-base"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Yaw °</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="1"
                                        [(ngModel)]="inspectingProp.rotation.z"
                                        class="text-base"
                                    />
                                </mat-form-field>
                            </div>
                        </div>
                    }
                    <!-- SECTION 4: Co giãn Scale -->
                    @if (inspectingProp.scale) {
                        <div>
                            <div
                                class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-2"
                            >
                                Co giãn 3D Scale (Scale X, Y, Z)
                            </div>
                            <div class="grid grid-cols-3 gap-3">
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Scale X</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="inspectingProp.scale.x"
                                        class="text-base"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Scale Y</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="inspectingProp.scale.y"
                                        class="text-base"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Scale Z</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="inspectingProp.scale.z"
                                        class="text-base"
                                    />
                                </mat-form-field>
                            </div>
                        </div>
                    }
                    <!-- SECTION 5: Chất liệu & Phát sáng (PBR & Emissive) -->
                    <div>
                        <div
                            class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-3"
                        >
                            Chất liệu & Ánh sáng (PBR & Emissive)
                        </div>
                        <div class="grid grid-cols-2 gap-4 mb-3">
                            <div class="flex items-end gap-2">
                                <input
                                    type="color"
                                    [(ngModel)]="inspectingProp.color"
                                    class="w-9 h-9 rounded-lg cursor-pointer border-0 outline-none p-0 bg-transparent shrink-0 self-end mb-1.5"
                                    title="Chọn màu 3D"
                                />
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix flex-1"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Màu 3D (Hex)</mat-label>
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="inspectingProp.color"
                                        class="font-mono text-base font-normal"
                                    />
                                </mat-form-field>
                            </div>
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label
                                    >Độ trong suốt Opacity (0-1)</mat-label
                                >
                                <input
                                    matInput
                                    type="number"
                                    step="0.05"
                                    min="0"
                                    max="1"
                                    [(ngModel)]="inspectingProp.opacity"
                                    class="text-base font-normal"
                                />
                            </mat-form-field>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mb-3">
                            <div class="flex items-end gap-2">
                                <input
                                    type="color"
                                    [(ngModel)]="inspectingProp.emissiveColor"
                                    class="w-9 h-9 rounded-lg cursor-pointer border-0 outline-none p-0 bg-transparent shrink-0 self-end mb-1.5"
                                    title="Chọn màu phát sáng"
                                />
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix flex-1"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Màu phát sáng (Hex)</mat-label>
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="
                                            inspectingProp.emissiveColor
                                        "
                                        class="font-mono text-base font-normal"
                                    />
                                </mat-form-field>
                            </div>
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label>Cường độ phát sáng (0-10)</mat-label>
                                <input
                                    matInput
                                    type="number"
                                    step="0.5"
                                    min="0"
                                    max="10"
                                    [(ngModel)]="
                                        inspectingProp.emissiveIntensity
                                    "
                                    class="text-base font-normal"
                                />
                            </mat-form-field>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label
                                    >Độ kim loại Metalness (0-1)</mat-label
                                >
                                <input
                                    matInput
                                    type="number"
                                    step="0.1"
                                    min="0"
                                    max="1"
                                    [(ngModel)]="inspectingProp.metalness"
                                    class="text-base"
                                />
                            </mat-form-field>
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label>Độ nhám Roughness (0-1)</mat-label>
                                <input
                                    matInput
                                    type="number"
                                    step="0.1"
                                    min="0"
                                    max="1"
                                    [(ngModel)]="inspectingProp.roughness"
                                    class="text-base"
                                />
                            </mat-form-field>
                        </div>
                    </div>
                    <!-- SECTION 6: Đổ bóng, Trạng thái Hiển thị & Tương tác 3D -->
                    <div class="space-y-3">
                        <div
                            class="flex items-center justify-between p-3 rounded-md bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800"
                        >
                            <span
                                class="text-base font-medium text-slate-700 dark:text-slate-200"
                                >Đổ bóng thực tế 3D (Cast Shadow)</span
                            >
                            <mat-slide-toggle
                                [(ngModel)]="inspectingProp.castShadow"
                                class="fuse-mat-dense fuse-mat-emphasized-affix"
                                color="primary"
                            ></mat-slide-toggle>
                        </div>
                        <div
                            class="flex items-center justify-between p-3 rounded-md bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800"
                        >
                            <div class="flex items-center space-x-2">
                                <mat-icon class="text-slate-500 icon-size-5">{{
                                    inspectingProp.visible !== false
                                        ? "visibility"
                                        : "visibility_off"
                                }}</mat-icon>
                                <span
                                    class="text-base font-medium text-slate-700 dark:text-slate-200"
                                    >Hiển thị trong không gian 3D</span
                                >
                            </div>
                            <mat-slide-toggle
                                [checked]="inspectingProp.visible !== false"
                                (change)="
                                    onPropVisibilityToggle($any($event).checked)
                                "
                                class="fuse-mat-dense fuse-mat-emphasized-affix"
                                color="primary"
                            ></mat-slide-toggle>
                        </div>
                        <div
                            class="flex items-center justify-between p-3 rounded-md bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800"
                        >
                            <div class="flex items-center space-x-2">
                                <mat-icon class="text-slate-500 icon-size-5"
                                    >touch_app</mat-icon
                                >
                                <span
                                    class="text-base font-medium text-slate-700 dark:text-slate-200"
                                    >Cho phép tương tác nhấp chuột 3D</span
                                >
                            </div>
                            <mat-slide-toggle
                                [(ngModel)]="inspectingProp.interactive"
                                class="fuse-mat-dense fuse-mat-emphasized-affix"
                                color="primary"
                            ></mat-slide-toggle>
                        </div>
                        @if (inspectingProp.interactive !== false) {
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label
                                    >Hành động khi nhấp chuột (Click
                                    Action)</mat-label
                                >
                                <mat-select
                                    [(ngModel)]="inspectingProp.clickAction"
                                    class="text-base font-normal"
                                >
                                    <mat-option value="focus"
                                        >Focus phóng to Camera tới đồ
                                        vật</mat-option
                                    >
                                    <mat-option value="toggle"
                                        >Bật / Tắt trạng thái hiển
                                        thị</mat-option
                                    >
                                    <mat-option value="trigger_event"
                                        >Kích hoạt sự kiện mặc định</mat-option
                                    >
                                    <mat-option value="custom"
                                        >Chạy kịch bản Lệnh tự do / AI
                                        Prompt</mat-option
                                    >
                                </mat-select>
                            </mat-form-field>
                        }
                    </div>
                </div>
                <mat-divider class="my-4"></mat-divider>
                <!-- THÀNH PHẦN CON & THIẾT BỊ PHỤ (SUB-DEVICES) -->
                <div class="space-y-4 text-base">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span
                                class="text-base font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400"
                                >Thành phần con & Thiết bị phụ</span
                            >
                            @if ((inspectingProp.subDevices || []).length > 0) {
                                <span
                                    class="px-2 py-0.5 text-xs font-semibold rounded-full bg-teal-500/10 text-teal-600 dark:text-teal-400"
                                >
                                    {{
                                        (inspectingProp.subDevices || []).length
                                    }}
                                    thành phần
                                </span>
                            }
                        </div>
                        <button
                            type="button"
                            mat-icon-button
                            color="primary"
                            (click)="
                                addSubDevice('custom', 'Thành phần con mới')
                            "
                            title="Thêm thành phần con"
                        >
                            <mat-icon class="icon-size-5">add</mat-icon>
                        </button>
                    </div>
                    <!-- Managed SubDevices List -->
                    <div
                        class="border rounded-md divide-y dark:divide-slate-800 border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 overflow-hidden"
                    >
                        @for (
                            sub of inspectingProp.subDevices || [];
                            track sub;
                            let idx = $index
                        ) {
                            <div
                                class="p-3 space-y-3 hover:bg-white dark:hover:bg-slate-800 transition-colors"
                            >
                                <!-- Tên thành phần con (Chuẩn Angular Material) -->
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Tên thành phần con</mat-label>
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="sub.name"
                                        placeholder="Nhập tên thành phần con..."
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                                <!-- Input Prompt tạo/cập nhật thành phần con -->
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label
                                        >Input Prompt tạo thành phần
                                        con</mat-label
                                    >
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="sub.customScript"
                                        (keydown.enter)="
                                            executeSubDevicePrompt(
                                                sub,
                                                inspectingProp
                                            )
                                        "
                                        placeholder="Nhập prompt mô tả hoặc kịch bản..."
                                        class="text-base font-normal pr-2"
                                    />
                                    <button
                                        type="button"
                                        mat-icon-button
                                        matSuffix
                                        (click)="
                                            executeSubDevicePrompt(
                                                sub,
                                                inspectingProp
                                            )
                                        "
                                        title="Gửi prompt tạo/cập nhật thành phần con 3D"
                                        class="mr-1"
                                    >
                                        <mat-icon
                                            class="icon-size-5 text-teal-600 dark:text-teal-400"
                                            >send</mat-icon
                                        >
                                    </button>
                                </mat-form-field>
                                <!-- Nút Bật/Tắt & Xóa ở dưới cùng -->
                                <div
                                    class="flex items-center justify-end gap-1 pt-1 border-t border-slate-100 dark:border-slate-800/60"
                                >
                                    <button
                                        type="button"
                                        mat-icon-button
                                        [color]="
                                            sub.enabled !== false
                                                ? 'accent'
                                                : 'default'
                                        "
                                        (click)="
                                            toggleSubDeviceState(
                                                sub,
                                                inspectingProp
                                            )
                                        "
                                        [title]="
                                            sub.enabled !== false
                                                ? 'Đang BẬT'
                                                : 'Đang TẮT'
                                        "
                                    >
                                        <mat-icon class="icon-size-5">{{
                                            sub.enabled !== false
                                                ? "power_settings_new"
                                                : "power_off"
                                        }}</mat-icon>
                                    </button>
                                    <button
                                        type="button"
                                        mat-icon-button
                                        color="warn"
                                        (click)="removeSubDevice(idx)"
                                        title="Xoá thành phần con"
                                    >
                                        <mat-icon class="icon-size-5"
                                            >delete_outline</mat-icon
                                        >
                                    </button>
                                </div>
                            </div>
                        }
                        @if (
                            !inspectingProp.subDevices ||
                            inspectingProp.subDevices.length === 0
                        ) {
                            <div
                                class="p-3 text-center text-base text-slate-400 italic"
                            >
                                Bấm "+" để thêm thành phần con cho đồ vật này.
                            </div>
                        }
                    </div>
                </div>
                <mat-divider class="my-4"></mat-divider>
                <!-- SỰ KIỆN CỦA ĐỒ VẬT -->
                <div class="space-y-4 text-base">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span
                                class="text-base font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400"
                                >Sự kiện</span
                            >
                            @if ((inspectingProp.events || []).length > 0) {
                                <span
                                    class="px-2 py-0.5 text-xs font-semibold rounded-full bg-teal-500/10 text-teal-600 dark:text-teal-400"
                                >
                                    {{
                                        (inspectingProp.events || []).length
                                    }}
                                    sự kiện
                                </span>
                            }
                        </div>
                        <button
                            type="button"
                            mat-icon-button
                            color="primary"
                            (click)="addPropEvent()"
                            title="Thêm sự kiện mới"
                        >
                            <mat-icon class="icon-size-5">add</mat-icon>
                        </button>
                    </div>
                    <!-- Managed Events List -->
                    <div
                        class="border rounded-md divide-y dark:divide-slate-800 border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 overflow-hidden"
                    >
                        @for (
                            evt of inspectingProp.events || [];
                            track evt;
                            let idx = $index
                        ) {
                            <div
                                class="p-3 space-y-3 hover:bg-white dark:hover:bg-slate-800 transition-colors"
                            >
                                <!-- Tên sự kiện -->
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Tên sự kiện</mat-label>
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="evt.name"
                                        placeholder="Nhập tên sự kiện..."
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                                <!-- Kịch bản lệnh tương tác động -->
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label
                                        >Kịch bản Lệnh tự do / AI
                                        Prompt</mat-label
                                    >
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="evt.customScript"
                                        (keydown.enter)="
                                            runSpecificPropEvent(evt)
                                        "
                                        placeholder="Nhập kịch bản hoặc lệnh tự do..."
                                        class="text-base font-normal pr-2"
                                    />
                                    <button
                                        type="button"
                                        mat-icon-button
                                        matSuffix
                                        (click)="runSpecificPropEvent(evt)"
                                        [disabled]="isProcessingPrompt"
                                        title="Chạy thử sự kiện"
                                        class="mr-1"
                                    >
                                        @if (!isProcessingPrompt) {
                                            <mat-icon
                                                class="icon-size-5 text-teal-600 dark:text-teal-400"
                                                >play_arrow</mat-icon
                                            >
                                        }
                                        @if (isProcessingPrompt) {
                                            <mat-icon
                                                class="icon-size-5 text-teal-600 animate-spin"
                                                >autorenew</mat-icon
                                            >
                                        }
                                    </button>
                                </mat-form-field>
                                <!-- Nút bấm Chạy thử & Xóa ở dưới cùng -->
                                <div
                                    class="flex items-center justify-end gap-1 pt-1 border-t border-slate-100 dark:border-slate-800/60"
                                >
                                    <button
                                        type="button"
                                        mat-icon-button
                                        color="accent"
                                        (click)="runSpecificPropEvent(evt)"
                                        [disabled]="isProcessingPrompt"
                                        title="Chạy thử sự kiện"
                                    >
                                        @if (!isProcessingPrompt) {
                                            <mat-icon class="icon-size-5"
                                                >play_arrow</mat-icon
                                            >
                                        }
                                        @if (isProcessingPrompt) {
                                            <mat-icon
                                                class="icon-size-5 animate-spin"
                                                >autorenew</mat-icon
                                            >
                                        }
                                    </button>
                                    <button
                                        type="button"
                                        mat-icon-button
                                        color="warn"
                                        (click)="removePropEvent(idx)"
                                        title="Xoá sự kiện"
                                    >
                                        <mat-icon class="icon-size-5"
                                            >delete_outline</mat-icon
                                        >
                                    </button>
                                </div>
                            </div>
                        }
                        @if (
                            !inspectingProp.events ||
                            inspectingProp.events.length === 0
                        ) {
                            <div
                                class="p-3 text-center text-base text-slate-400 italic"
                            >
                                Bấm nút "+" để thêm sự kiện cho đồ vật này.
                            </div>
                        }
                    </div>
                </div>
            </div>
            <!-- Footer (Fixed at bottom) -->
            <div
                class="flex items-center justify-between px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 shrink-0"
            >
                <button
                    mat-icon-button
                    color="warn"
                    (click)="deletePropFromInspector($event, inspectingProp.id)"
                    title="Xóa đồ vật"
                >
                    <mat-icon class="icon-size-5">delete_outline</mat-icon>
                </button>
                <div class="flex items-center space-x-2">
                    <button mat-button (click)="inspectingProp = null">
                        Hủy
                    </button>
                    <button
                        mat-flat-button
                        color="primary"
                        (click)="savePropInspector()"
                    >
                        Lưu thay đổi
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- MODAL DIALOG QUẢN LÝ THÀNH PHẦN CON (SUB-DEVICES MANAGER) -->
<!-- ========================================== -->
@if (isSubDevicesModalOpen) {
    <div
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in"
    >
        <div
            class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden"
        >
            <!-- Header -->
            <div
                class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40"
            >
                <div class="flex items-center gap-3">
                    <mat-icon class="text-teal-500 icon-size-6"
                        >widgets</mat-icon
                    >
                    <div>
                        <h2
                            class="text-lg font-bold text-slate-800 dark:text-slate-100"
                        >
                            Màn hình Quản lý Thành phần con & Thiết bị phụ
                        </h2>
                        <p class="text-xs text-slate-400">
                            Quản lý toàn bộ subDevices, thuộc tính và prompt
                            lệnh hành động 3D trong Căn phòng 306
                        </p>
                    </div>
                </div>
                <button
                    mat-icon-button
                    (click)="closeAllSubDevicesModal()"
                    title="Đóng"
                >
                    <mat-icon>close</mat-icon>
                </button>
            </div>
            <!-- Toolbar Search & Stats -->
            <div class="p-6 pb-2 space-y-4">
                <div class="grid grid-cols-3 gap-4">
                    <div
                        class="p-4 border rounded-xl border-teal-500/20 bg-teal-500/5"
                    >
                        <div
                            class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400"
                        >
                            Tổng Thành Phần Con
                        </div>
                        <div
                            class="text-2xl font-black text-slate-800 dark:text-slate-100 mt-1"
                        >
                            {{ getAllSubDevices().length }}
                        </div>
                    </div>
                    <div
                        class="p-4 border rounded-xl border-emerald-500/20 bg-emerald-500/5"
                    >
                        <div
                            class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400"
                        >
                            Đang Hoạt Động (BẬT)
                        </div>
                        <div
                            class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1"
                        >
                            {{ activeSubDevicesCount }}
                        </div>
                    </div>
                    <div
                        class="p-4 border rounded-xl border-amber-500/20 bg-amber-500/5"
                    >
                        <div
                            class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400"
                        >
                            Đồ Vật Mẹ Có SubDevices
                        </div>
                        <div
                            class="text-2xl font-black text-slate-800 dark:text-slate-100 mt-1"
                        >
                            {{ propsWithSubDevicesCount }}
                        </div>
                    </div>
                </div>
                <!-- Search Bar -->
                <mat-form-field
                    class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                    [subscriptSizing]="'dynamic'"
                >
                    <mat-icon matPrefix class="icon-size-5 text-slate-400 mr-2"
                        >search</mat-icon
                    >
                    <input
                        matInput
                        type="text"
                        [(ngModel)]="subDeviceSearchQuery"
                        placeholder="Tìm kiếm theo tên thành phần con, prompt lệnh hoặc đồ vật..."
                        class="text-base"
                    />
                    @if (subDeviceSearchQuery) {
                        <button
                            mat-icon-button
                            matSuffix
                            (click)="subDeviceSearchQuery = ''"
                        >
                            <mat-icon class="icon-size-4">close</mat-icon>
                        </button>
                    }
                </mat-form-field>
            </div>
            <!-- SubDevices List -->
            <div class="p-6 overflow-y-auto flex-1 custom-scrollbar space-y-4">
                @for (item of filteredAllSubDevices; track item) {
                    <div
                        class="p-4 border rounded-xl border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 hover:border-teal-500/50 transition-all space-y-3"
                    >
                        <!-- Top Row: Tên & Đồ vật mẹ -->
                        <div class="flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3 flex-1 min-w-0">
                                <mat-icon class="text-teal-500 icon-size-5"
                                    >smart_button</mat-icon
                                >
                                <div class="flex-1 min-w-0">
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="item.sub.name"
                                        placeholder="Tên thành phần con..."
                                        class="text-base font-bold text-slate-800 dark:text-slate-100 border-b border-slate-200 dark:border-slate-700 bg-transparent px-1 py-0.5 w-full"
                                    />
                                    <div class="text-xs text-slate-400 mt-0.5">
                                        Đồ vật mẹ:
                                        <span
                                            class="font-semibold text-teal-600 dark:text-teal-400"
                                            >{{ item.prop.name }}</span
                                        >
                                    </div>
                                </div>
                            </div>
                            <!-- Action buttons -->
                            <div class="flex items-center gap-2">
                                <button
                                    type="button"
                                    mat-icon-button
                                    (click)="
                                        openSubDeviceInspector(
                                            item.prop,
                                            item.sub,
                                            $event
                                        )
                                    "
                                    title="Chỉnh sửa Thuộc tính & Phương thức"
                                >
                                    <mat-icon
                                        class="icon-size-5 text-slate-400 hover:text-teal-600"
                                        >tune</mat-icon
                                    >
                                </button>
                                <button
                                    type="button"
                                    mat-icon-button
                                    [color]="
                                        item.sub.enabled ? 'accent' : 'default'
                                    "
                                    (click)="
                                        toggleSubDeviceStateFromGlobal(
                                            item.prop,
                                            item.sub
                                        )
                                    "
                                    [title]="
                                        item.sub.enabled
                                            ? 'Đang BẬT'
                                            : 'Đang TẮT'
                                    "
                                >
                                    <mat-icon class="icon-size-5">{{
                                        item.sub.enabled
                                            ? "power_settings_new"
                                            : "power_off"
                                    }}</mat-icon>
                                </button>
                                <button
                                    type="button"
                                    mat-icon-button
                                    color="warn"
                                    (click)="
                                        removeSubDeviceFromGlobal(
                                            item.prop,
                                            item.index
                                        )
                                    "
                                    title="Xóa thành phần con"
                                >
                                    <mat-icon class="icon-size-5"
                                        >delete_outline</mat-icon
                                    >
                                </button>
                            </div>
                        </div>
                        <!-- Bottom Row: Input Prompt + Send Button -->
                        <div class="flex items-center gap-2">
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix flex-1"
                                [subscriptSizing]="'dynamic'"
                            >
                                <input
                                    matInput
                                    type="text"
                                    [(ngModel)]="item.sub.customScript"
                                    (keydown.enter)="
                                        executeSubDevicePrompt(
                                            item.sub,
                                            item.prop
                                        )
                                    "
                                    placeholder="Input Prompt tạo/cập nhật thành phần con..."
                                    class="text-base font-medium pr-2"
                                />
                                <button
                                    type="button"
                                    mat-icon-button
                                    matSuffix
                                    (click)="
                                        executeSubDevicePrompt(
                                            item.sub,
                                            item.prop
                                        )
                                    "
                                    title="Gửi prompt AI tạo/cập nhật 3D"
                                    class="mr-1"
                                >
                                    <mat-icon
                                        class="icon-size-4 text-teal-600 dark:text-teal-400"
                                        >send</mat-icon
                                    >
                                </button>
                            </mat-form-field>
                        </div>
                    </div>
                }
                @if (filteredAllSubDevices.length === 0) {
                    <div class="p-8 text-center text-slate-400 italic">
                        Không tìm thấy thành phần con nào.
                    </div>
                }
            </div>
            <!-- Footer -->
            <div
                class="flex items-center justify-between px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40"
            >
                <span class="text-xs text-slate-400"
                    >Tự động đồng bộ Realtime với 3D PlayCanvas Engine</span
                >
                <button
                    mat-flat-button
                    color="primary"
                    (click)="closeAllSubDevicesModal()"
                    class="rounded-xl"
                >
                    Đóng Quản Lý
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- MODAL DIALOG CHỈNH SỬA THUỘC TÍNH & PHƯƠNG THỨC SUBDEVICE -->
<!-- ========================================== -->
@if (inspectingSubDevice) {
    <div
        class="fixed inset-0 z-[99999] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in"
    >
        <div
            class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden text-base"
        >
            <!-- Header -->
            <div
                class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 shrink-0"
            >
                <div>
                    <h2
                        class="text-lg font-bold tracking-tight m-0 text-slate-800 dark:text-slate-100 truncate pr-2"
                    >
                        {{ inspectingSubDevice.sub.name }}
                    </h2>
                    <p class="text-xs text-slate-400">
                        Thuộc đồ vật mẹ:
                        <span
                            class="font-semibold text-teal-600 dark:text-teal-400"
                            >{{ inspectingSubDevice.prop.name }}</span
                        >
                    </p>
                </div>
                <button
                    mat-icon-button
                    (click)="closeSubDeviceInspector()"
                    title="Đóng"
                >
                    <mat-icon class="icon-size-5">close</mat-icon>
                </button>
            </div>
            <!-- Body (Strictly constrained scroll area) -->
            <div
                class="px-6 py-4 space-y-4 overflow-y-auto flex-1 custom-scrollbar text-base"
            >
                <!-- FORM INPUTS -->
                <div class="space-y-4 text-base">
                    <!-- SECTION 1: Thông tin chung -->
                    <div class="space-y-3">
                        <div
                            class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-2"
                        >
                            Thông tin chung
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label>Tên thành phần con</mat-label>
                                <input
                                    matInput
                                    type="text"
                                    [(ngModel)]="inspectingSubDevice.sub.name"
                                    placeholder="Nhập tên thành phần con..."
                                    class="text-base font-normal"
                                />
                            </mat-form-field>
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label>Hình dáng 3D (Shape)</mat-label>
                                <mat-select
                                    [(ngModel)]="inspectingSubDevice.sub.shape"
                                    class="text-base font-normal"
                                >
                                    <mat-option value="sphere"
                                        >Khối cầu 3D (Hình tròn)</mat-option
                                    >
                                    <mat-option value="box"
                                        >Khối chữ nhật 3D (Hình
                                        vuông)</mat-option
                                    >
                                </mat-select>
                            </mat-form-field>
                        </div>
                    </div>
                    <!-- SECTION 2: Tọa độ 3D Position -->
                    @if (inspectingSubDevice.sub.position) {
                        <div>
                            <div
                                class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-2"
                            >
                                Tọa độ 3D Position (X, Y, Z)
                            </div>
                            <div class="grid grid-cols-3 gap-3">
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Trục X</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.position.x
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Trục Y (Cao)</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.position.y
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Trục Z</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.position.z
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                            </div>
                        </div>
                    }
                    <!-- SECTION 3: Góc xoay 3D Rotation -->
                    @if (inspectingSubDevice.sub.rotation) {
                        <div>
                            <div
                                class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-2"
                            >
                                Góc xoay 3D Rotation (Roll, Pitch, Yaw °)
                            </div>
                            <div class="grid grid-cols-3 gap-3">
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Roll °</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.rotation.x
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Pitch °</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.rotation.y
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Yaw °</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.rotation.z
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                            </div>
                        </div>
                    }
                    <!-- SECTION 4: Co giãn Scale -->
                    @if (inspectingSubDevice.sub.scale) {
                        <div>
                            <div
                                class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-2"
                            >
                                Co giãn 3D Scale (Scale X, Y, Z)
                            </div>
                            <div class="grid grid-cols-3 gap-3">
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Scale X</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.scale.x
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Scale Y</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.scale.y
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Scale Z</mat-label>
                                    <input
                                        matInput
                                        type="number"
                                        step="0.1"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.scale.z
                                        "
                                        class="text-base font-normal"
                                    />
                                </mat-form-field>
                            </div>
                        </div>
                    }
                    <!-- SECTION 5: Chất liệu & Ánh sáng (PBR & Emissive) -->
                    <div>
                        <div
                            class="text-base font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider mb-3"
                        >
                            Chất liệu & Ánh sáng (PBR & Emissive)
                        </div>
                        <div class="grid grid-cols-2 gap-4 mb-3">
                            <div class="flex items-end gap-2">
                                <input
                                    type="color"
                                    [(ngModel)]="inspectingSubDevice.sub.color"
                                    class="w-9 h-9 rounded-lg cursor-pointer border-0 outline-none p-0 bg-transparent shrink-0 self-end mb-1.5"
                                    title="Chọn màu 3D"
                                />
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix flex-1"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Màu 3D (Hex)</mat-label>
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub.color
                                        "
                                        class="font-mono text-base font-normal"
                                    />
                                </mat-form-field>
                            </div>
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label
                                    >Độ trong suốt Opacity (0-1)</mat-label
                                >
                                <input
                                    matInput
                                    type="number"
                                    step="0.05"
                                    min="0"
                                    max="1"
                                    [(ngModel)]="
                                        inspectingSubDevice.sub.opacity
                                    "
                                    class="text-base font-normal"
                                />
                            </mat-form-field>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mb-3">
                            <div class="flex items-end gap-2">
                                <input
                                    type="color"
                                    [(ngModel)]="
                                        inspectingSubDevice.sub.emissiveColor
                                    "
                                    class="w-9 h-9 rounded-lg cursor-pointer border-0 outline-none p-0 bg-transparent shrink-0 self-end mb-1.5"
                                    title="Chọn màu phát sáng"
                                />
                                <mat-form-field
                                    class="fuse-mat-dense fuse-mat-emphasized-affix flex-1"
                                    [subscriptSizing]="'dynamic'"
                                >
                                    <mat-label>Màu phát sáng (Hex)</mat-label>
                                    <input
                                        matInput
                                        type="text"
                                        [(ngModel)]="
                                            inspectingSubDevice.sub
                                                .emissiveColor
                                        "
                                        class="font-mono text-base font-normal"
                                    />
                                </mat-form-field>
                            </div>
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label>Cường độ phát sáng (0-10)</mat-label>
                                <input
                                    matInput
                                    type="number"
                                    step="0.5"
                                    min="0"
                                    max="10"
                                    [(ngModel)]="
                                        inspectingSubDevice.sub
                                            .emissiveIntensity
                                    "
                                    class="text-base font-normal"
                                />
                            </mat-form-field>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label
                                    >Độ kim loại Metalness (0-1)</mat-label
                                >
                                <input
                                    matInput
                                    type="number"
                                    step="0.1"
                                    min="0"
                                    max="1"
                                    [(ngModel)]="
                                        inspectingSubDevice.sub.metalness
                                    "
                                    class="text-base font-normal"
                                />
                            </mat-form-field>
                            <mat-form-field
                                class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                [subscriptSizing]="'dynamic'"
                            >
                                <mat-label>Độ nhám Roughness (0-1)</mat-label>
                                <input
                                    matInput
                                    type="number"
                                    step="0.1"
                                    min="0"
                                    max="1"
                                    [(ngModel)]="
                                        inspectingSubDevice.sub.roughness
                                    "
                                    class="text-base font-normal"
                                />
                            </mat-form-field>
                        </div>
                    </div>
                    <!-- SECTION 6: Đổ bóng & Trạng thái Hiển thị -->
                    <div class="space-y-3">
                        <div
                            class="flex items-center justify-between p-3 rounded-md bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800"
                        >
                            <span
                                class="text-base font-medium text-slate-700 dark:text-slate-200"
                                >Đổ bóng thực tế 3D (Cast Shadow)</span
                            >
                            <mat-slide-toggle
                                [(ngModel)]="inspectingSubDevice.sub.castShadow"
                                class="fuse-mat-dense fuse-mat-emphasized-affix"
                                color="primary"
                            ></mat-slide-toggle>
                        </div>
                        <div
                            class="flex items-center justify-between p-3 rounded-md bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800"
                        >
                            <div class="flex items-center space-x-2">
                                <mat-icon class="text-slate-500 icon-size-5">{{
                                    inspectingSubDevice.sub.enabled !== false
                                        ? "visibility"
                                        : "visibility_off"
                                }}</mat-icon>
                                <span
                                    class="text-base font-medium text-slate-700 dark:text-slate-200"
                                    >Hiển thị trong không gian 3D</span
                                >
                            </div>
                            <mat-slide-toggle
                                [checked]="
                                    inspectingSubDevice.sub.enabled !== false
                                "
                                (change)="
                                    toggleSubDeviceStateFromGlobal(
                                        inspectingSubDevice.prop,
                                        inspectingSubDevice.sub
                                    )
                                "
                                class="fuse-mat-dense fuse-mat-emphasized-affix"
                                color="primary"
                            ></mat-slide-toggle>
                        </div>
                    </div>
                    <mat-divider class="my-4"></mat-divider>
                    <!-- SECTION 8: SỰ KIỆN CỦA THÀNH PHẦN CON -->
                    <div class="space-y-4 text-base">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-base font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400"
                                    >Sự kiện</span
                                >
                                @if (
                                    (inspectingSubDevice.sub.events || [])
                                        .length > 0
                                ) {
                                    <span
                                        class="px-2 py-0.5 text-xs font-semibold rounded-full bg-teal-500/10 text-teal-600 dark:text-teal-400"
                                    >
                                        {{
                                            (
                                                inspectingSubDevice.sub
                                                    .events || []
                                            ).length
                                        }}
                                        sự kiện
                                    </span>
                                }
                            </div>
                            <button
                                type="button"
                                mat-icon-button
                                color="primary"
                                (click)="
                                    addSubDeviceEvent(inspectingSubDevice.sub)
                                "
                                title="Thêm sự kiện mới"
                            >
                                <mat-icon class="icon-size-5">add</mat-icon>
                            </button>
                        </div>
                        <!-- Managed Events List -->
                        <div
                            class="border rounded-md divide-y dark:divide-slate-800 border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 overflow-hidden"
                        >
                            @for (
                                evt of inspectingSubDevice.sub.events || [];
                                track evt;
                                let idx = $index
                            ) {
                                <div
                                    class="p-3 space-y-3 hover:bg-white dark:hover:bg-slate-800 transition-colors"
                                >
                                    <!-- Tên sự kiện -->
                                    <mat-form-field
                                        class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                        [subscriptSizing]="'dynamic'"
                                    >
                                        <mat-label>Tên sự kiện</mat-label>
                                        <input
                                            matInput
                                            type="text"
                                            [(ngModel)]="evt.name"
                                            placeholder="Nhập tên sự kiện..."
                                            class="text-base font-normal"
                                        />
                                    </mat-form-field>
                                    <!-- Kịch bản lệnh tương tác động -->
                                    <mat-form-field
                                        class="fuse-mat-dense fuse-mat-emphasized-affix w-full"
                                        [subscriptSizing]="'dynamic'"
                                    >
                                        <mat-label
                                            >Kịch bản Lệnh tự do / AI
                                            Prompt</mat-label
                                        >
                                        <input
                                            matInput
                                            type="text"
                                            [(ngModel)]="evt.customScript"
                                            (keydown.enter)="
                                                executeSubDevicePrompt(
                                                    evt,
                                                    inspectingSubDevice.prop
                                                )
                                            "
                                            placeholder="Nhập kịch bản hoặc lệnh tự do..."
                                            class="text-base font-normal pr-2"
                                        />
                                        <button
                                            type="button"
                                            mat-icon-button
                                            matSuffix
                                            (click)="
                                                executeSubDevicePrompt(
                                                    evt,
                                                    inspectingSubDevice.prop
                                                )
                                            "
                                            [disabled]="isProcessingPrompt"
                                            title="Chạy thử sự kiện"
                                            class="mr-1"
                                        >
                                            @if (!isProcessingPrompt) {
                                                <mat-icon
                                                    class="icon-size-5 text-teal-600 dark:text-teal-400"
                                                    >play_arrow</mat-icon
                                                >
                                            }
                                            @if (isProcessingPrompt) {
                                                <mat-icon
                                                    class="icon-size-5 text-teal-600 animate-spin"
                                                    >autorenew</mat-icon
                                                >
                                            }
                                        </button>
                                    </mat-form-field>
                                    <!-- Nút bấm Chạy thử & Xóa ở dưới cùng -->
                                    <div
                                        class="flex items-center justify-end gap-1 pt-1 border-t border-slate-100 dark:border-slate-800/60"
                                    >
                                        <button
                                            type="button"
                                            mat-icon-button
                                            color="accent"
                                            (click)="
                                                executeSubDevicePrompt(
                                                    evt,
                                                    inspectingSubDevice.prop
                                                )
                                            "
                                            [disabled]="isProcessingPrompt"
                                            title="Chạy thử sự kiện"
                                        >
                                            @if (!isProcessingPrompt) {
                                                <mat-icon class="icon-size-5"
                                                    >play_arrow</mat-icon
                                                >
                                            }
                                            @if (isProcessingPrompt) {
                                                <mat-icon
                                                    class="icon-size-5 animate-spin"
                                                    >autorenew</mat-icon
                                                >
                                            }
                                        </button>
                                        <button
                                            type="button"
                                            mat-icon-button
                                            color="warn"
                                            (click)="
                                                removeSubDeviceEvent(
                                                    inspectingSubDevice.sub,
                                                    idx
                                                )
                                            "
                                            title="Xoá sự kiện"
                                        >
                                            <mat-icon class="icon-size-5"
                                                >delete_outline</mat-icon
                                            >
                                        </button>
                                    </div>
                                </div>
                            }
                            @if (
                                !inspectingSubDevice.sub.events ||
                                inspectingSubDevice.sub.events.length === 0
                            ) {
                                <div
                                    class="p-3 text-center text-base text-slate-400 italic"
                                >
                                    Bấm nút "+" để thêm sự kiện cho thành phần
                                    con này.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!-- Footer (Fixed at bottom) -->
            <div
                class="flex items-center justify-between px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 shrink-0"
            >
                <button
                    mat-icon-button
                    color="warn"
                    (click)="
                        removeSubDeviceFromGlobal(
                            inspectingSubDevice.prop,
                            inspectingSubDevice.prop.subDevices.indexOf(
                                inspectingSubDevice.sub
                            )
                        );
                        closeSubDeviceInspector()
                    "
                    title="Xóa thành phần con"
                >
                    <mat-icon class="icon-size-5">delete_outline</mat-icon>
                </button>
                <div class="flex items-center space-x-2">
                    <button mat-button (click)="closeSubDeviceInspector()">
                        Hủy
                    </button>
                    <button
                        mat-flat-button
                        color="primary"
                        (click)="saveSubDeviceInspector()"
                    >
                        Lưu thay đổi
                    </button>
                </div>
            </div>
        </div>
    </div>
}

/* Switch bat/tat hieu ung script tren the */
.fx-enable-toggle {
    margin-right: 0.25rem;
    flex-shrink: 0;
}
.prop-card__name--disabled {
    opacity: 0.45;
    text-decoration: line-through;
}
